@inproceedings{20261920689814 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2026 Elsevier Inc.},
copyright = {Compendex},
title = {Large Language Models in MCDA Weight Elicitation: A Systematic Review},
journal = {Lecture Notes in Business Information Processing},
author = {Ouzounis, Michail Rafail and Papathanasiou, Jason and Tsaples, Georgios and Drogalas, Georgios},
volume = {582 LNBIP},
year = {2026},
pages = {257 - 269},
issn = {18651348},
address = {Plymouth, United kingdom},
abstract = {The rapid advancement of Large Language Models has sparked growing interest in their integration into Multi-Criteria Decision Analysis, particularly in weight extraction methodologies. However, despite the increased research activity of recent years, a unified methodological framework that clearly guides the use of LLMs in the weighting process is still missing, along with consensus on how to ensure transparency and reliability in the generated results. The aim of this study is to systematically review the literature from 2020 to 2025 and critically investigate how LLMs have been used in the field of MCDA for weight extraction. The findings reveal significant methodological heterogeneity in terms of both prompt engineering and evaluation protocols, including comparisons with human experts. Despite their potential, current LLM-based weight elicitation approaches often fail to consistently capture human judgment. Finally, the review highlights the lack of comprehensive methodologies, discovering that the field is still in its early stages and requires efforts to standardize and develop transparent, valid, and reproducible methodologies for the use of LLMs in criterion weighting. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
key = {Decision support systems},
keywords = {Artificial intelligence;Behavioral research;Decision making;Decision theory;Extraction;Reliability analysis;},
note = {Consistency analysis;Decision supports;Language model;Large language model;Multi-criteria decision analysis;Multi-criteria decision analyze;Prompt engineering;Reliability and consistency analyze;Support systems;Weight elicitation;},
URL = {http://dx.doi.org/10.1007/978-3-032-25146-6_17},
} 


@unpublished{20240075098 ,
