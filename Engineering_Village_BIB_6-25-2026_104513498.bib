address = {Hybrid, Surabaya, Indonesia},
abstract = {This study develops a Decision Support System (DSS) model to assist HR managers within the Directorate General of Customs and Excise (DJBC) in regional scope determining employee transfers based on predefined criteria and rules derived from regulations, expert opinions, and best practices. The DSS integrates Multi-Criteria Decision Making (MCDM) techniques, specifically the Technique for Order Preference by Similarity to Ideal Solution (TOPSIS), along with rule-based systems and profile matching to model employee transfer decisions. It classifies transfer eligibility, ranks destination offices, and provides the top three recommended locations. Validation through black-box testing confirms 100% accuracy for rule-based processing, while evaluation of 92 employee assessment samples using Slovin's method aligns with manual profile matching results. The ranking of suggested transfer destinations is perceived as appropriate by HR managers. Usability testing using the System Usability Scale (SUS) yields a score of 70, indicating favourable usability. The DSS model is recommended for integration into personnel systems with expanded variables and rules. © 2025 IEEE.},
