author = {Svoboda, Igor and Lande, Dmytro},
year = {2024},
issn = {23318422},
abstract = {Our study presents a new framework that incorporates the Analytic Hierarchy Process (AHP) and Generative Pre-trained Transformer 4 (GPT-4) large language model (LLM), bringing novel approaches to cybersecurity Multiple-criteria Decision Analysis (MCDA). By utilizing the capabilities of GPT-4 autonomous agents as virtual experts, we automate the decision-making process, enhancing both efficiency and reliability. This new approach focuses on leveraging LLMs for sophisticated decision analysis, highlighting the synergy between traditional decision-making models and cutting-edge AI technologies. Our innovative methodology demonstrates significant advancements in using AI-driven agents for complex decision-making scenarios, highlighting the importance of AI in strategic cybersecurity applications. The findings reveal the transformative potential of combining AHP and LLMs, establishing a new paradigm for intelligent decision support systems in cybersecurity and beyond. © 2024, CC BY.},
key = {Analytic hierarchy process},
keywords = {Artificial intelligence;Autonomous agents;Decision making;Decision support systems;Hierarchical systems;},
note = {ChatGPT;Cyber security;Generative AI;Generative pre-trained transformer 4;Language model;Large language model;MCDM;Multi criteria decision-making;Multicriteria decision-making;Multicriterion decision makings;Virtual expert;},
URL = {http://dx.doi.org/10.48550/arXiv.2402.07404},
} 


@unpublished{20240334218 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2026 Elsevier Inc.},
copyright = {Compendex},
title = {Optimizing Supplier Selection with Large Language Models: An AI-Driven Approach for Resilient Supply Chains},
journal = {Research Square},
author = {Akbar, Demiral and Simsek, Murat},
year = {2024},
abstract = {Artificial Intelligence (AI) is poised to play a transformative role in Industry 4.0 and beyond. The challenges amplified by global crises, such as pandemics, have further emphasized the need for digitalization and optimization to maintain a resilient and sustainable supply chain from both buyer and supplier perspectives. Buyers must build and sustain a robust pool of suppliers capable of withstanding disruptions, while suppliers must enhance their visibility and demonstrate their capabilities effectively. Achieving this balance increasingly relies on AI-powered systems, once the appropriate digital infrastructure and data are in place. Traditional supplier selection, often based solely on cost, is no longer sufficient. Instead, procurement strategies must focus on long-term risk mitigation, requiring multi-criteria decision-making approaches. Among the AI techniques employed, Genetic Algorithms (GA) offer optimal solutions by evaluating numerous factors simultaneously. Recently, Large Language Models (LLMs) have gained attention for their ability to process vast volumes of unstructured data, enabling more comprehensive and nuanced supplier evaluations. LLMs, such as DistilGPT-2, can be integrated into decision support systems to enhance planning, forecasting, and supplier selection by considering diverse criteria, including price, delivery time, customs, taxes, production capabilities, warranty policies, and quality assurance. In this study, an AI-driven, end-to-end supplier selection approach using DistilGPT-2 was implemented. The model generated and evaluated textual data to effectively identify the most suitable supplier, demonstrating both time efficiency and decision accuracy. These findings highlight the growing potential of LLMs in optimizing supply chain management under increasingly complex market dynamics. © 2024, CC BY.},
key = {Genetic algorithms},
keywords = {Artificial intelligence;Decision making;Decision support systems;Quality assurance;Supply chain management;Supply chains;},
note = {Chain management;Digital infrastructures;Generative artificial intelligence;Language model;Large language model;Optimisations;Procurement strategy;Supplier relationship managements;Supplier selection;Sustainable supply chains;},
URL = {http://dx.doi.org/10.21203/rs.3.rs-4767072/v2},
} 


@inproceedings{20261320344416 ,
language = {English},
copyright = {Compilation and indexing terms, Copyright 2026 Elsevier Inc.},
copyright = {Compendex},
title = {MedArg-Assist: An Explainable Framework for Clinical Treatment Plan Verification Based on Argumentation Chains and Knowledge Augmentation},
journal = {Proceedings - 2025 IEEE International Conference on Bioinformatics and Biomedicine, BIBM 2025},
author = {Liu, Wenxin and Xiao, Liang and Wang, Shun},
year = {2025},
pages = {7020 - 7027},
address = {Wuhan, China},
abstract = {With the advancement of medical intelligence, Clinical Decision Support Systems (CDSS) have become increasingly central in assisting diagnosis, optimizing treatment pathways, and enhancing personalized care quality, serving as a critical pillar of modern medicine. However, current systems largely rely on black-box models that lack interpretability, thereby limiting trust among both physicians and patients. To address this challenge, we propose MedArg-Assist, an explainable framework for clinical plan verification that integrates argumentation chains with knowledge augmentation. The framework employs a structured Critical Question Chain to guide reasoning and leverages both multi-source medical knowledge and large language models (LLMs) to support explainable validation and optimal plan recommendation. Specifically, the system first conducts a layered evaluation of the current treatment plan via critical questions, performing consistency checks between external knowledge retrieval and LLM-generated responses to ensure reliability. For multi-plan recommendation, the framework incorporates a Multi-Criteria Decision Analysis (MCDA) model based on Fuzzy Analytic Hierarchy Process (Fuzzy AHP) and (Technique for Order Preference by Similarity to Ideal Solution) TOPSIS, assessing candidate plans across three dimensions - effectiveness, safety, and personalization - to produce the optimal recommendation along with interpretable justifications. A case study on hypertension treatment demonstrates the framework's potential to enhance transparency and credibility in clinical decision-making, indicating strong applicability in real-world scenarios. © 2025 IEEE.},
key = {Artificial intelligence},
keywords = {Analytic hierarchy process;Chains;Decision making;Decision support systems;Diagnosis;Knowledge management;Medical education;Personalized medicine;},
note = {Argumentation frameworks;Clinical decision support;Clinical decision support systems;Clinical treatment plans;Critical questions;Knowledge-augmented reasoning;Language model;Large language model;Modern medicine;Plan verifications;},
URL = {http://dx.doi.org/10.1109/BIBM66473.2025.11356982},
} 


