title = {Adaptive Exploration: Elevating Educational Impact of Unsupervised Knowledge Graph Question Answering},
journal = {Communications in Computer and Information Science},
author = {Yang, Xi and Chen, Zhangze and Guo, Hanghui and Shestakevych, Tetiana},
