@inproceedings{10.1145/3109859.3109905,
author = {Musto, Cataldo and de Gemmis, Marco and Semeraro, Giovanni and Lops, Pasquale},
title = {A Multi-criteria Recommender System Exploiting Aspect-based Sentiment Analysis of Users' Reviews},
year = {2017},
isbn = {9781450346528},
publisher = {Association for Computing Machinery},
