@inproceedings{10.1145/3580305.3599292,
author = {Park, Jin-Duk and Li, Siqing and Cao, Xin and Shin, Won-Yong},
title = {Criteria Tell You More than Ratings: Criteria Preference-Aware Light Graph Convolution for Effective Multi-Criteria Recommendation},
year = {2023},
isbn = {9798400701030},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez371.periodicos.capes.gov.br/10.1145/3580305.3599292},
doi = {10.1145/3580305.3599292},
abstract = {The multi-criteria (MC) recommender system, which leverages MC rating information in a wide range of e-commerce areas, is ubiquitous nowadays. Surprisingly, although graph neural networks (GNNs) have been widely applied to develop various recommender systems due to GNN's high expressive capability in learning graph representations, it has been still unexplored how to design MC recommender systems with GNNs. In light of this, we make the first attempt towards designing a GNN-aided MC recommender system. Specifically, rather than straightforwardly adopting existing GNN-based recommendation methods, we devise a novel criteria preference-aware light graph convolution (CPA-LGC ) method, which is capable of precisely capturing the criteria preference of users as well as the collaborative signal in complex high-order connectivities. To this end, we first construct an MC expansion graph that transforms user-item MC ratings into an expanded bipartite graph to potentially learn from the collaborative signal in MC ratings. Next, to strengthen the capability of criteria preference awareness, CPA-LGC incorporates newly characterized embeddings, including user-specific criteria-preference embeddings and item-specific criterion embeddings, into our graph convolution model. Through comprehensive evaluations using four real-world datasets, we demonstrate (a) the superiority over benchmark MC recommendation methods and benchmark recommendation methods using GNNs with tremendous gains, (b) the effectiveness of core components in CPA-LGC, and (c) the computational efficiency.},
booktitle = {Proceedings of the 29th ACM SIGKDD Conference on Knowledge Discovery and Data Mining},
pages = {1808–1819},
numpages = {12},
keywords = {collaborative signal, criteria preference, graph neural network, light graph convolution, multi-criteria recommender system},
location = {Long Beach, CA, USA},
series = {KDD '23}
}

@inproceedings{10.1145/3776759.3776805,
author = {Yuan, Mingyang and Wang, Bentian and Su, Shuoxuan and Qin, Wen},
title = {Architectural Form Generation Driven by Text-Guided Generative Modeling Based on Intent Image Reconstruction and Multi-Criteria Evaluation},
year = {2025},
isbn = {9798400721007},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez371.periodicos.capes.gov.br/10.1145/3776759.3776805},
doi = {10.1145/3776759.3776805},
abstract = {This study proposes an integrated workflow for early-stage architectural form generation and evaluation by combining text-guided generative image models and parametric modeling tools. The approach establishes a continuous design process capable of transforming natural language cues into editable 3D geometric models. Intention-driven conceptual image sets are generated under iterative semantic control using text-to-image diffusion models such as Stable diffusion and Midjourney. These images are subsequently processed through contour extraction and scale mapping algorithms to reconstruct approximate volume models in the Rhino-Grasshopper environment. Standardized geometric constraints and scale rules are applied during the reconstruction process to ensure formal consistency between different scenarios. For design evaluation, a multi-criteria framework including volume metrics, open rates and bilateral symmetries is introduced to support transparent scheme selection. Visualization tools such as radar charts and comparison matrices are used to facilitate design diagnosis and optimization. A prototype case study involving an airport terminal demonstrated the effectiveness of the workflow: 64 design variants were generated and reconstructed with 4.2 times more diversity than manually drawn concepts. In addition, the process identified scenarios with improved area-to-volume ratios and surface-to-height ratios. The results emphasize the semantic controllability of text-guided generative modeling in form exploration and the utility of parametric platforms in achieving early assessment of geometric consistency.},
booktitle = {Proceedings of the 2025 International Symposium on Artificial Intelligence and Computational Social Sciences},
pages = {291–296},
numpages = {6},
keywords = {architectural form generation, design evaluation, parametric design, rhinoceros-grasshopper, semantic cues, text-to-image modeling, visual reconstruction},
location = {
},
series = {AICSS '25}
}

