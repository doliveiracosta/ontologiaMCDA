@CONFERENCE{Kumar2006150,
	author = {Kumar, Nishant and Vanthienen, Jan and De Beer, Jan and Moens, Marie-Francine},
	title = {Multi-criteria evaluation of information retrieval tools},
	year = {2006},
	journal = {ICEIS 2006 - 8th International Conference on Enterprise Information Systems, Proceedings},
	volume = {AIDSS},
	pages = {150 - 155},
	url = {https://www.scopus.com/pages/publications/77953900214?origin=resultslist},
	affiliations = {Katholieke Universiteit Leuven, Leuven Institute for Research on Information Systems, 3000 Leuven, Naamsestraat 69, Belgium; Katholieke Universiteit Leuven, Legal Informatics and Information Retrieval, ICRI, 3000 Leuven, Tiensestraat 41, Belgium},
	abstract = {We propose a generic methodology for the evaluation of Text Mining/Search and Information Retrieval tools based on their functional conformity to a predefined set of functional requirements prioritized by distinguishable user profiles. The methodology is worked out and applied within the context of a research project concerning the assessment of intelligent exploitation tools for unstructured information sources in the police domain. We present the general setting of our work, give an overview of our evaluation approach, and discuss our methodology for testing in greater detail. These kinds of evaluations are particularly useful for both (potential) purchasers of exploitation tools, given the high investments in time and money required in becoming proficient in their use, and developers who aim at producing better quality software products.},
	author_keywords = {Decision support systems; Information retrieval; Knowledge representation; Text mining},
	keywords = {Artificial intelligence; Decision making; Decision support systems; Decision theory; Information systems; Knowledge representation; Law enforcement; Natural language processing systems; Evaluation approach; Exploitation tool; Functional requirement; Information sources; Multi-criteria evaluation; Quality software; Text mining; User profile; Information retrieval},
	correspondence_address = {N. Kumar; Katholieke Universiteit Leuven, Leuven Institute for Research on Information Systems, 3000 Leuven, Naamsestraat 69, Belgium; email: nishant.kumar@econ.kuleuven.be},
	isbn = {9728865422; 978-972886542-9},
	language = {English},
	abbrev_source_title = {ICEIS - Int. Conf. Enterp. Inf. Syst., Proc.},
	type = {Conference paper},
