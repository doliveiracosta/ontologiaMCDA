@ARTICLE{Liu2026,
	author = {Liu, Qicai and Hu, Zhichao and Huang, Tao and Niu, Yupeng and Zhang, Xinche and Ma, Shanwu and Lin, Chutong and Huat, Goh Kim and Kwon, Hyeokkoo Eric and Gao, Feng and Sun, Xianfu and Ying, Zhitao and Qiang, Guangliang},
	title = {EvoMDT: a self-evolving multi-agent system for structured clinical decision-making in multi-cancer},
	year = {2026},
	journal = {npj Digital Medicine},
	volume = {9},
	number = {1},
	pages = {},
	doi = {10.1038/s41746-025-02304-8},
	url = {https://www.scopus.com/pages/publications/105029352145?origin=resultslist},
	affiliations = {Department of Reproductive Medicine Centre, The First Affiliated Hospital, Fujian Medical University, Fuzhou, China; School of Biomedical Engineering, Tsinghua University, Beijing, China; Department of Information Technology and Operations Management, Nanyang Technological University, Singapore, Singapore; Department of Breast Disease, Henan Breast Cancer Center, The Affiliated Cancer Hospital of Zhengzhou University & Henan Cancer Hospital, Zhengzhou, China; Tianjin Key Laboratory of Radiation Medicine and Molecular Nuclear Medicine, Institute of Radiation Medicine, Chinese Academy of Medical Science & Peking Union Medical College, Tianjin, China; Department of Thoracic Surgery, Peking University Third Hospital, Beijing, China; Department of Pathology, The First Affiliated Hospital, Fujian Medical University, Fuzhou, China; Department of Pathology, National Regional Medical Center, Fujian Medical University, Binhai Campus of the First Affiliated Hospital, Fuzhou, China; Department of Medical Oncology, National Cancer Center/National Clinical Research Center for Cancer/Cancer Hospital, Chinese Academy of Medical Sciences & Peking Union Medical College, Beijing, China},
	abstract = {Multidisciplinary tumor boards (MDTs) are central to cancer care but remain constrained by scarce experts and variable decision quality. EvoMDT employs a self-evolution loop that updates prompts, consensus weights, and retrieval scope based on expert feedback and outcome signals, improving robustness without sacrificing traceability. This matters clinically because MDT workloads and evidence shift over time, requiring adaptive yet auditable decision support. Agents perform domain-specific inference over lesion-level clinical data with structured knowledge retrieval; a consensus protocol resolves conflicts and generates traceable, evidence-linked recommendations. Evaluation spanned six public oncology QA benchmarks and four real-world datasets (breast, liver, lung, lymphoma), followed by single-blind physician assessment. Quantitative metrics (ROUGE, BERTScore) and automated safety checks assessed factuality and guideline concordance, while clinicians rated clinical appropriateness and usability. EvoMDT outperformed frontier Large Language Models (LLMs) baselines (e.g., Llama-3-70B, Claude-3, Med-PaLM 2), improving guideline concordance and semantic alignment with expert plans (BERTScore 0.62–0.68) and reducing safety violations. In physician review, EvoMDT achieved decision quality comparable to human MDTs while shortening response time by 30–40%. These results position EvoMDT as an interpretable, evidence-traceable framework that operationalizes AI reasoning for multidisciplinary oncology practice and offers a scalable foundation for trustworthy, lesion-level precision cancer care. © The Author(s) 2026.},
	keywords = {Benchmarking; Decision making; Diseases; Lung cancer; Multi agent systems; Oncology; Semantics; cyclophosphamide; diagnostic agent; entecavir; fludarabine; osimertinib; rituximab; Clinical data; Clinical decision making; Decision quality; Decision supports; Domain specific; Expert feedback; Knowledge retrieval; Multiagent systems (MASs); Self- evolutions; Structured knowledge; adult; antiviral therapy; Article; breast cancer; cancer chemotherapy; cancer combination chemotherapy; clinical article; clinical decision making; clinical decision support system; clinical protocol; consensus; controlled study; disease ontology; female; follow up; hemorrhagic cystitis; human; knowledge base; laparoscopic liver resection; large language model; liver cell carcinoma; liver lobectomy; lumpectomy; lung adenocarcinoma; lymphoma; male; middle aged; multicriteria decision analysis; non-Hodgkin lymphoma; person centered care; product vigilance; program appropriateness; semantics; single blind procedure; treatment response; Decision support systems},
	correspondence_address = {X. Sun; Department of Breast Disease, Henan Breast Cancer Center, The Affiliated Cancer Hospital of Zhengzhou University & Henan Cancer Hospital, Zhengzhou, China; email: zlyysunxianfu1256@zzu.edu.cn; G. Qiang; Department of Thoracic Surgery, Peking University Third Hospital, Beijing, China; email: pkudd@bjmu.edu.cn; Z. Ying; Department of Medical Oncology, National Cancer Center/National Clinical Research Center for Cancer/Cancer Hospital, Chinese Academy of Medical Sciences & Peking Union Medical College, Beijing, China; email: yingzhitao001@163.com},
	publisher = {Nature Research},
	issn = {23986352},
	language = {English},
	abbrev_source_title = {npj Digit. Med.},
	type = {Article},
	publication_stage = {Final},
