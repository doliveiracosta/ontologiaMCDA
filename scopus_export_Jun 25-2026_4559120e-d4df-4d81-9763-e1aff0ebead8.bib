	url = {https://www.scopus.com/pages/publications/105041634989?origin=resultslist},
	affiliations = {Southeast University, Department of Computer Science and Engineering, Dhaka, Bangladesh},
	abstract = {Insomnia constitutes a substantial public health issue that adversely impacts both mental and physical wellbeing, particularly among adolescents. Conventional diagnostic techniques frequently fail to provide prompt identification due to the complexity and variety of the illness. This study introduces a robust machine learning framework for the binary classification of insomnia, integrating advanced data preprocessing, multicriteria feature selection, and explainable artificial intelligence to enhance predictive accuracy and clinical interpretability. To reduce bias and ensure data quality, we applied a thorough preprocessing workflow that included label encoding, Min-Max scaling, and stratified sampling. Our study utilizes the publicly available 'Insomnia in Adolescence' dataset, which contains behavioral, demographic, and psychometric factors. In order to select the best group of predictors, a hybrid strategy that combined ANOVA (p ≤ 0.05), mutual information ranking (top 50%), and variance thresholding (variance <0.05) was used. Stratified cross-validation was employed to construct and assess various classifiers, including ensemble models, K-Nearest Neighbors, Random Forest, Support Vector Machine, and Logistic Regression. With an accuracy of 92.85% and a recall of 100%, Random Forest outperformed the others, showcasing a remarkable capacity to reduce false negatives, which is crucial for clinical settings. Despite ensemble methods such as RF+SVM provided competitive performance, they failed to surpass Random Forest. Deep neural networks performed poorly despite evaluation due to the limited dataset size, indicating that traditional machine learning models are better suited for small-sample settings. In order to improve interpretability and clinical application, feature contributions were quantified using SHapley Additive exPlanations (SHAP). © 2025 IEEE.},
	author_keywords = {Deep Neural Network; Explainable AI; Feature Selection; Insomnia; Machine Learning},
	keywords = {Classification (of information); Computer aided diagnosis; Data accuracy; Deep learning; Diseases; Learning systems; Logistic regression; Nearest neighbor search; Sampling; Support vector regression; Classification approach; Disease classification; Explainable AI; Features optimizations; Features selection; Insomnia; Interpretability; Machine-learning; Neural-networks; Random forests; Feature extraction},
