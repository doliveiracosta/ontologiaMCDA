@CONFERENCE{Tangphoklang201121,
	author = {Tangphoklang, Pakapon and Maneeroj, Saranya and Takasu, Atsuhiro},
	title = {A novel weighting scheme for a multi-criteria rating recommender system},
	year = {2011},
	journal = {Proceedings of the IADIS International Conference Information Systems 2011, IS 2011},
	pages = {21 - 29},
	url = {https://www.scopus.com/pages/publications/84868304814?origin=resultslist},
	affiliations = {Chulalongkorn University, Bangkok, Thailand; National Institute of Informatics, Tokyo, Japan},
	abstract = {Recommender systems aim to introduce interesting items to a particular user. Most use a single rating or overall score representing the user's overall preference toward each item to produce a recommendation. Recently, many researchers have proved that multi-criteria ratings provide better results than a single criterion. According to the concept of multicriteria rating recommender systems, the criteria weight is integrated with the user profile to identify the importance the user attaches to each criterion. If a suitable weight is obtained, the user characteristics will be more correctly represented. Consequently, high-quality neighbors and high-accuracy recommendations will be formed. Nowadays, weight assignment is developed automatically and adaptively, but does not consider the detailed rating information about how much all possible rating scores affect the user preference on each criterion. In this work, a new weighting scheme is proposed based on the assumption that considering detailed rating information will produce a better recommendation. The new weighting scheme, called pf-ipf (preference frequency - inverse preference frequency), counts the frequency of possible individual rating score occurrences instead of words in the concept of tf-idf coming form the text-mining. Experimental evaluation shows that our pf-ipf technique is effective. © 2011 IADIS.},
	author_keywords = {Criteria weight assignment; Knowledge management; MCDM (multi-criteria decision making); Multi-attribute recommender system; Multi-criteria rating recommender system},
	keywords = {Data mining; Decision making; Information systems; Knowledge management; Rating; Criteria weights; Experimental evaluation; Multi criteria decision making; Multi-attributes; Multi-criteria ratings; Rating information; User characteristics; Weight assignment; Recommender systems},
