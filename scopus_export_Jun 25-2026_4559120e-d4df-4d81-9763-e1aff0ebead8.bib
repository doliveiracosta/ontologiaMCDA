@CONFERENCE{Zhao20253731,
	author = {Zhao, Zhengyi and Zhang, Shubo and Wang, Zezhong and Wang, Huimin and Zhao, Yutian and Liang, Bin and Zheng, Yefeng and Li, Binyang and Wong, Kam-Fai and Wu, Xian},
	title = {T2: An Adaptive Test-Time Scaling Strategy for Contextual Question Answering},
	year = {2025},
	journal = {EMNLP 2025 - 2025 Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
	pages = {3731 - 3756},
	doi = {10.18653/v1/2025.emnlp-main.185},
	url = {https://www.scopus.com/pages/publications/105040241235?origin=resultslist},
	affiliations = {The Chinese University of Hong Kong, Hong Kong; University of International Relations, China; Tencent Jarvis Lab, China; Westlake University, China; Ministry of Education Key Laboratory of High Confidence Software Technologies, CUHK, Hong Kong},
	abstract = {Recent advances in Large Language Models (LLMs) have demonstrated remarkable performance in Contextual Question Answering (CQA). However, prior approaches typically employ elaborate reasoning strategies regardless of question complexity, leading to low adaptability. Recent efficient test-time scaling methods introduce budget constraints or early stop mechanisms to avoid overthinking for straightforward questions. But they add human bias to the reasoning process and fail to leverage models' inherent reasoning capabilities. To address these limitations, we present T<sup>2</sup>: Think-to-Think, a novel framework that dynamically adapts reasoning depth based on question complexity. T<sup>2</sup> leverages the insight that if an LLM can effectively solve similar questions using specific reasoning strategies, it can apply the same strategy to the original question. This insight enables the adoption of concise reasoning for straightforward questions while maintaining detailed analysis for complex problems. T<sup>2</sup> works through four key steps: decomposing questions into structural elements, generating similar examples with candidate reasoning strategies, evaluating these strategies against multiple criteria, and applying the most appropriate strategy to the original question. Experimental evaluation across seven diverse CQA benchmarks demonstrates that T<sup>2</sup> not only achieves higher accuracy than baseline methods but also reduces computational overhead by up to 25.2%. © 2025 Association for Computational Linguistics.},
	keywords = {Computational complexity; Computational linguistics; Natural language processing systems; Question answering; Adaptive tests; Budget constraint; Early-stop; Human bias; Language model; Performance; Question Answering; Scaling method; Test time; Time-scaling; Budget control},
	correspondence_address = {B. Li; University of International Relations, China; email: byli@uir.edu.cn},
	editor = {Christodoulopoulos C. and Chakraborty T. and Rose C. and Peng V.},
	publisher = {Association for Computational Linguistics (ACL)},
	isbn = {979-889176332-6},
	language = {English},
	abbrev_source_title = {EMNLP - Conf. Empir. Methods Nat. Lang. Process., Proc. Conf.},
	type = {Conference paper},
