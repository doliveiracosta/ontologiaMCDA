	author_keywords = {MCDM; Negation handling; Social media response; VIKOR},
	keywords = {Classification (of information); Decision making; Reliability analysis; Social networking (online); Syntactics; Cognitive approaches; Multi criteria decision-making; Multicriteria decision-making; Multicriterion decision makings; Negation handling; Sentiment analysis; Sentiment classification; Social media; Social medium response; VIKOR; Sentiment analysis},
