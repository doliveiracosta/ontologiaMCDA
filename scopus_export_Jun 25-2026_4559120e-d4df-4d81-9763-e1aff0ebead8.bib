	journal = {Global Congress on Emerging Technologies, GCET 2024},
	pages = {125 - 131},
	doi = {10.1109/GCET64327.2024.10934712},
	url = {https://www.scopus.com/pages/publications/105002557304?origin=resultslist},
	affiliations = {University of Science and Technology Houari Boumedienne (USTHB), MOVEP Laboratory, Faculty of Computer Science, Algiers, Algeria; University of Bejaia, LIMED Laboratory, Faculty of Exact Sciences, Bejaia, 06000, Algeria},
	abstract = {The process of selecting Software as a Service (SaaS) in Cloud Computing depends on providers' capabilities to articulate the non-functional attributes of their SaaS offerings semantically and understand customer requests along with their non-functional requirements. This study conceptualizes SaaS selection as a multi-criteria combinatorial problem within predefined constraints. To address this, we introduce a hybrid approach incorporating an entire optimization algorithm. Our method leverages semantic and microservice (individual) SaaS descriptions in the Ontology Web Language for Services (OWL-S). Each micro SaaS is linked to compatible SaaS instances (offering similar functionality) in a unified environment, guided by the compatibility concept. A micro-SaaS may not satisfy a particular functional need in specific contexts. However, it is possible to meet customer requirements by combining the available SaaS instances, called virtual SaaS. The chosen SaaS should be the best based on the defined quality and quantitative criteria. Our proposed approach, employing multi-criteria analysis, capitalizes on a dedicated Quality of Service (QoS) ontology tailored for the cloud environment and web applications. Moreover, a simulation design proved that a substantial selection of SaaS(s) could be achieved in a cloud.  © 2024 IEEE.},
	author_keywords = {Cloud computing; Multi-criteria; Quality of Service (QoS); Selection of SaaS services; Semantic Annotations; Whole optimization algorithm},
	keywords = {Quality of service; Software as a service (SaaS); Virtual environments; Cloud environments; Cloud-computing; Multi-criteria; Multi-Criterion; Optimization algorithms; Quality of service; Quality-of-service; Selection of saa service; Semantic annotations; Whole optimization algorithm; Cloud platforms},
