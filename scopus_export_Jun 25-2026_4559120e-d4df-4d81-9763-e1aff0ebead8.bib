@CONFERENCE{Ramya R2025,
	author = {Ramya R, R. and Jegadeesan, S. and Rooba, A. Gnana and Santhana Krishnan, R. and Francis Raj, J. Relin and Alice Blessie, A.},
	title = {ACRecoMasterNet++: A Deep Learning-based Multi-Criteria Framework for Personalized Air Conditioner Recommendation},
	year = {2025},
	journal = {Proceedings of the 7th International Conference on Innovative Data Communication Technologies and Application, ICIDCA 2025},
	pages = {},
	doi = {10.1109/ICIDCA66325.2025.11280485},
	url = {https://www.scopus.com/pages/publications/105031410620?origin=resultslist},
	affiliations = {Vel Tech Rangarajan Dr. Sagunthala R&d Institute of Science and Technology, Department of Computer Science and Engineering, Avadi, Chennai, India; Velammal College of Engineering and Technology, Department of Information Technology, Madurai, India; Scad College of Engineering and Technology, Department of Electronics and Communication Engineering, Cheranmhadevi, India; Saveetha Institute of Medical and Technical Sciences, Saveetha School of Engineering, Department of Electronics and Communication Engineering, Chennai, India; Government College of Engineering, Department of Electronics and Communication Engineering, Tirunelveli, India},
	abstract = {ACRecoMasterNet++ is a deep learning-based hybrid recommendation framework developed to assist consumers in selecting optimal air conditioners by integrating diverse data sources, including technical specifications, user reviews, environmental parameters, and user preferences. The system utilizes a modular architecture with specialized neural components to generate accurate, interpretable, and context-sensitive recommendations. A BiLSTM with Attention module performs aspect-based sentiment analysis on user reviews, identifying sentiments associated with cooling efficiency, operational noise, and after-sale service. An LSTM-based environmental module incorporates contextual information such as local temperature, humidity, and air quality, enabling climate-aware recommendations. A Feedforward Neural Network (FNN) aggregates eleven critical features, including SEER, BTU-to-room-size ratio, noise level, pricing, and sentiment scores, into a final recommendation score. Personalization is achieved using Neural Collaborative Filtering (NCF), while cold-start users are accommodated through demographic clustering based on location, lifestyle, and spending behavior. The framework effectively integrates both structured specifications and unstructured feedback, providing meaningful rankings aligned with user expectations. Evaluation using metrics such as Precision@10, NDCG@10, and Aspect F1 Score demonstrates its accuracy and practical value. ACRecoMasterNet++ offers a transparent, adaptive, and intelligent solution that enhances user decision-making in selecting suitable cooling systems.  © 2025 IEEE.},
	author_keywords = {Air Conditioner Recommendation; Climate Aware Recommendations; Environmental Adaptation; GloVe Embeddings; Hybrid Model; Score Aggregation; User Preference Matching},
