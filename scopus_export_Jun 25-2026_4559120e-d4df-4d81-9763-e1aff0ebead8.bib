@CONFERENCE{Ahmed2025128,
	author = {Ahmed, Mai Hesham and Aboul-Ela, Magdy and Elwakil, Randa and Ibrahim, Basem M.},
	title = {Next-Generation MCDM: How AI is Revolutionizing the Decision Support Process},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 12th International Conference on Intelligent Computing and Information Systems, ICICIS 2025},
