@CONFERENCE{Ebaid20257,
	author = {Ebaid, Hesham A. and Amgad, Eyad and Raslan, Zeyad and Elkhouly, Ahmed and Behairy, Khaled and Fares, Ahmed},
	title = {Context-Aware Translation of Egyptian Hieroglyphs via Symbol Segmentation, Classification, and Retrieval-Augmented LLMs},
	year = {2025},
	journal = {Proceedings of the 13th International Japan-Africa Conference on Electronics, Communications, and Computations, JAC-ECC 2025},
	pages = {7 - 12},
	doi = {10.1109/JAC-ECC67970.2025.11417496},
	url = {https://www.scopus.com/pages/publications/105035991530?origin=resultslist},
	affiliations = {Egypt-Japan University of Science and Technology (E-JUST), Department of Computer Science and Engineering, Alexandria, 21934, Egypt; Benha University, Faculty of Engineering at Shoubra, Department of Electrical Engineering, Cairo, 11629, Egypt},
	abstract = {This paper presents a fully automated approach to translating ancient Egyptian hieroglyphs from inscription images into readable English narratives. Our system combines cutting-edge computer vision, deep learning, and retrieval-augmented generation (RAG) methods in a seamless pipeline. Images are first processed and segmented using the Segment Anything Model (SAM), and symbols are then identified using a fine-tuned InceptionV3 network trained across 171 Gardiner sign classes. For translation, we leverage a large language model (Qwen330B) enhanced by an expert-curated Egyptological knowledge base to produce interpretations grounded in historical context. We evaluated the framework on 10 authentic inscription images, achieving 86.3% accuracy with the symbol classifier. Translation quality-measured by historical accuracy, cultural fidelity, and narrative coherence-received scores ranging from 6.3 to 9.1 in a multi-criteria RAG-based assessment. While the dataset size was limited, these findings demonstrate the promise of our system for scalable, context-aware hieroglyph translation, offering valuable support for digital humanities, education, and Egyptological scholarship. © 2025 IEEE.},
