@CONFERENCE{Li2023,
	author = {Li, Lin},
	title = {Investigating the Application of 3D Avatar Chatbot Services on Fintech},
	year = {2023},
	journal = {29th Annual Americas Conference on Information Systems, AMCIS 2023},
	pages = {},
	url = {https://www.scopus.com/pages/publications/85192946017?origin=resultslist},
	affiliations = {School of Computer and Cyber Sciences, Augusta University, United States},
	abstract = {Artificial Intelligence (AI)-generated 3D avatar chatbots have arisen to be the next wave of digital banking innovation, 3D avatar chatbots are referred to as 3D human-like virtual assistances that stimulate human conversations using natural language processing (NLP) to understand human inputs, either in voice or text, and respond accordingly (Angga et al., 2015). The 3D avatar chatbot services are closely connected with FinTech, which is related to the use of technology to improve financial services. To be specific, 3D avatar chatbot services can be used to enhance customer experience, automate customer service, and provide personalized financial advice (Van Doorn et al., 2017). Compared to text-based chatbots, 3D avatar chatbots are designed to provide an empathetic, personalized, and interactive experience to users. Investigating the service quality of 3D avatar chatbots is important because it can help organizations understand the effectiveness of their 3D avatar chatbot services and identify areas for improvement, as measuring service quality can provide feedback on how well a 3D avatar chatbot performs in meeting users' needs and expectations (Berry & Parasuraman, 1997). However, the quality of 3D avatar chatbot services has rarely been investigated even though the key quality dimensions of 3D avatar chatbot services should be identified and considered in the design process. The research objectives are therefore twofold: (1) investigating which quality dimension(s) are best in predicting the satisfaction of the 3D avatar chatbot services by using a machine learning approach, and (2) studying whether the best quality dimension(s) perceived differently in various services in banking. This study is expected to contribute to the knowledge of AI-empowered 3D avatar chatbot services and practically guide to better understand the different perceptions of the quality of 3D avatar chatbot services. Nine quality dimensions for 3D avatar chatbot services are selected in the study: (1) reliability, (2) responsiveness, (3) assurance, (4) empathy, (5) understandability, (6) interactivity (verbal), (7) interactivity (nonverbal), (8) personalization, and (9) sociability. Among these, four dimensions, namely reliability, responsiveness, assurance, and empathy are derived from Parasuraman et al. (1988)'s proposal on service quality (SERVQUAL) dimensions and they have been widely applied to measure consumers’ perceptions in terms of service quality. The remaining five dimensions, which are understandability, interactivity (verbal), interactivity (nonverbal), personalization, and sociability are included because 3D avatar chatbots have inbuilt NLP, machine learning, and computer vision to simulate human-like interactions with users so that they can provide a personalized, socialized, and interactive experience to users (Hasan et al. 2021). The following methodologies are applied to this research. First, supervised machine learning algorithms (such as support vector machines (SVM), K-nearest-neighbor (k-NN), decision tree, and random forests) are employed to predict which quality dimension(s) among the proposed nine dimensions of quality dimensions are best in predicting users’ satisfaction level of the 3D avatar chatbot services. Moreover, the multicriteria decision analysis (MCDA) modeling is employed to examine the ranking of the perception of the best quality dimension(s) in various online and offline services in banking, such as (online) customer service, personalized recommendations, fraud prevention, support for financial education, and (offline) branch assistance, accessibility support, personalized banking, and chitchat. © 2023 29th Annual Americas Conference on Information Systems, AMCIS 2023. All rights reserved.},
	keywords = {Information systems; Information use; Natural language processing systems; Sales; Three dimensional computer graphics; 3D Avatars; Chatbots; Customer-service; Human like; Interactivity; Language processing; Natural languages; Quality dimension; Service Quality; Understandability; Quality of service},
