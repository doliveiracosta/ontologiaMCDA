@ARTICLE{Pereira2025,
	author = {Pereira, Antônio and Viegas, Felipe and Dias, Diego Roberto Colombo and Tuler, Elisa and Machado, Ana Cláudia and Fonseca, Guilherme and Gonçalves, Marcos André and Rocha, Leonardo},
	title = {“Are the current topic modeling evaluation metrics enough?” Mitigating the limitations of topic modeling evaluation metrics using a multi-perspective game theoretic approach},
	year = {2025},
	journal = {Knowledge-Based Systems},
	volume = {320},
	pages = {},
