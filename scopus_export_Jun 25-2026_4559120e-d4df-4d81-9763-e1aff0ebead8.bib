	keywords = {Discriminant analysis; Multilayer neural networks; Multilayers; Reliability analysis; Decision reliability; Discriminant analysis model; Linear discriminant analyze; Multi-criteria decision making problems; Multilayers perceptrons; Organization, rangement et synthese dedonnees relarionnelles; Perceptron neural networks; Robustness, correlation, and standard deviation; Standard deviation; Transport safety; Decision making},
