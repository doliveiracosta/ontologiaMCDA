	language = {English},
	abbrev_source_title = {Artif. Intell. Res. in Control and Automation Eng.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Callegari2009376,
