	keywords = {Classification (of information); Computational efficiency; Decision making; Fuzzy rules; Linguistics; Social networking (online); Discrimination informations; Group multi-criteria sorting; Health rumor-refutation ability; Minimum discrimination information; Multi-criteria; Multi-Criterion; Optimal clustering; Optimal clustering algorithm; Social media; Social medium account; Social Network Analysis; Clustering algorithms},
