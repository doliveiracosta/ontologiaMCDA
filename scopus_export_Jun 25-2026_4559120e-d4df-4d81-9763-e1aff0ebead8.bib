@ARTICLE{Göksel2025,
	author = {Göksel, Gökhan and Aydın, Ahmet and Batmaz, Zeynep and Kaleli, Cihan},
	title = {A novel missing value imputation for multi-criteria recommender systems},
	year = {2025},
	journal = {Information Sciences},
