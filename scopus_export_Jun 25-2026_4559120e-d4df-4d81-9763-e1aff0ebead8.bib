@CONFERENCE{Kodumuri2025188,
	author = {Kodumuri, Srujana and Dadi, Ramesh},
	title = {Deep Learning-Enhanced Multi-Modal Fusion for Anomaly-based Insider Threat Detection in Enterprise Environments},
	year = {2025},
	journal = {International Conference on NexGen Networks and Cybernetics, IC2NC 2025 - Proceedings},
	pages = {188 - 194},
	doi = {10.1109/IC2NC67409.2025.11376104},
	url = {https://www.scopus.com/pages/publications/105035613661?origin=resultslist},
	affiliations = {Sr University, School of Computer Science and Artificaial Intelligence, Telangana, Warangal, 506371, India},
	abstract = {Insider threats are creating more cyber security challenges, with the unauthorized access and knowledge of organizational security measures. This research presents a novel multi-modal hybrid ensemble method, by integrating behavioral analytics, BERT-based semantic embeddings, and psychometric profiling for insider threat detection. The model extracts 30+ behavioral features from authentication logs, device interactions, email communications, and file operations, while generating deep semantic representations using BERT transformers, and the big dimensions are reduced with PCA. The labels are generated with an intelligent labeling mechanism based on z-score normalization and multi-criteria thresholding. The weighted ensemble architecture combines Random Forest, XGBoost, LightGBM, and Gradient Boosting classifiers with performance-adaptive weighting. The model is evaluated on the CERT R4.2 dataset, and the framework achieves exceptional performance: 99.25% accuracy, 99.23% weighted F1-score and AUC scores in between 0.995-1.000. The performance of the model illustrates that psychometric risk profiling significantly enhances detection capabilities, with the composite risk score emerging as the most discriminative feature, validating this interdisciplinary approach for operational enterprise security deployment. © 2025 IEEE.},
	author_keywords = {Deep learning; ensemble model; fusion model; Insider threat detection},
