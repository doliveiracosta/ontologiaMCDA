	url = {https://www.scopus.com/pages/publications/105020937380?origin=resultslist},
	affiliations = {School of Finance and Economics, Jiangsu University, Zhenjiang, 212013, China; School of Economics, Liaoning University, Shenyang, 110036, China; School of Management, Shenyang University of Technology, Shenyang, 110036, China; Department of Intervention, Liaoning Police Academy, Dalian, 116036, China},
	abstract = {Urban resilience has emerged as a critical paradigm for sustainable development amid escalating climatic, social, and economic uncertainties. Rapid urbanization, resource depletion, and frequent compound disasters underline the need for more adaptive, data-driven resilience assessment frameworks. However, existing evaluation models often fail to capture the interactions and nonlinear chrematistics that characterize complex urban systems. Addressing this gap, this study develops an interpretable machine learning framework that integrates multi-criteria decision-making (MCDM) with the SHapley Additive exPlanations (SHAP) approach to evaluate the urban resilience index (URI) and identify its key determinants in China's Yangtze River Economic Belt (YREB)—a region encompassing 108 cities from 2011 to 2019. Results reveal an overall 18.49 % growth in YREB's URI increase, albeit with strong spatial heterogeneity−downstream cities consistently outperform midstream and upstream regions. XGBoost-SHAP analysis identified governance (24.69 % contribution) and infrastructure (23.19 %) as dominant determinants, with fiscal debt ratio (X23) and foreign investment (X25) being pivotal. Furthermore, four resilience archetypes emerged through a clustering algorithm, highlighting divergent policy priorities—advanced systems require innovation-driven governance, while fragile systems necessitate infrastructure-social security synergies. This study advances urban resilience theory through methodological integration of explainable AI and dynamic assessment, offering scalable solutions for global cities navigating compound pressures. © 2025 Elsevier Ltd},
	author_keywords = {Interpretable machine learning; MCDM; SHAP; Urban resilience; Yangtze river economic belt},
