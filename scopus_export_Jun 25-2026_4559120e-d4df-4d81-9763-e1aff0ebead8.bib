@CONFERENCE{Darm2025106,
	author = {Darm, Paul and Parsonage, Ben and Wilson, Callum and Riccardi, Annalisa and Vasile, Massimiliano},
	title = {Explainable Decision Support for Conjunction Risk Analysis and the Design of Robust Collision Avoidance Manoeuvres},
	year = {2025},
	journal = {Proceedings of the International Astronautical Congress, IAC},
	pages = {106 - 117},
	doi = {10.52202/083086-0012},
	url = {https://www.scopus.com/pages/publications/105032516801?origin=resultslist},
	affiliations = {Department of Mechanical & Aerospace Engineering, University of Strathclyde, 16 Richmond St, Glasgow, Gl 1XQ, United Kingdom},
	abstract = {With the growing number of satellites in Low Earth Orbit, it is necessary to reconsider operational procedures to address the compounding risks and consequences associated with an increasingly dense space environment. A rise in both the number of conjunction alerts, and the potential future impact of a catastrophic collision, complicates the overall management of space traffic and necessitates the automation of tasks and protocols to alleviate the burden on operators' capabilities. This paper proposes an update to CASSANDRA, an intelligent agent designed to support Space Traffic Management decision making, to include consideration of collision severity in the autonomous design of robust Collision Avoidance Manoeuvres (CAMs) within an explainable Artificial Intelligence (XAI) layer. CASSANDRA combines the Dempster-Shafer theory of evidence with machine learning techniques to robustly and promptly address satellite conjunctions in both single and multiple event scenarios. The current implementation provides event classification based on the risk level and confidence in the provided information. Remedial CAMs may then be analytically designed to reduce both the Probability of Collision (PoC) and the associated uncertainty. This work enhances CASSANDRA with advanced Natural Language Processing (NLP) and Large Language Models (LLMs) to increase the transparency of suggested actions and the reasoning behind them. These technologies translate complex data into simple and clear summaries, helping operators to quickly grasp collision scenarios and clearly see the potential outcomes of their decisions. The complete pipeline operates as follows: available encounters, like synthetic observations, real or virtual Conjunction Data Messages (CDMs), are input into CASSANDRA to evaluate collision risk based on belief states. For cases requiring CAMs, several alternative avoidance actions are designed. A Multi-Criteria Decision Making module is then implemented to recommend a single action to the operator, accounting for 1) the effectiveness in reducing the worst-case PoC, 2) the costs associated with the manoeuvre, and 3) an assessment of the secondary risks that could occur if a CAM is not performed. A final reclassification step is added to ensure the safety of the manoeuvre with respect to the uncertainty of the available information. At each stage, the XAI layer delivers a clear and concise plain-language description of the current recommendations and the supporting reasoning. This methodology is illustrated with several numerical cases using realistic simulated observations. Copyright © 2025 by the International Astronautical Federation (IAF). All rights reserved.},
	keywords = {Artificial intelligence; Autonomous agents; Behavioral research; Collision avoidance; Computational linguistics; Decision making; Decision support systems; Earth (planet); Intelligent agents; Natural language processing systems; Risk analysis; Risk assessment; Safety engineering; Satellites; 'current; Catastrophic collisions; Collision avoidance maneuver; Decision supports; Earth orbits; Operational procedures; Risk analyze; Space environment; Space traffic; Uncertainty; Orbits},
	correspondence_address = {P. Darm; Department of Mechanical & Aerospace Engineering, University of Strathclyde, Glasgow, 16 Richmond St, Gl 1XQ, United Kingdom; email: paul.darm@strath.ac.uk},
	publisher = {International Astronautical Federation, IAF},
