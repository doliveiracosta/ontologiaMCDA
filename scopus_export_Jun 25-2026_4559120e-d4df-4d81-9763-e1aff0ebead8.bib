	title = {Criteria-Based LLM Relevance Judgments},
	year = {2025},
	journal = {ICTIR 2025 - Proceedings of the 2025 International ACM SIGIR Conference on Innovative Concepts and Theories in Information Retrieval},
	pages = {254 - 263},
