@BOOK{Pan202366,
	author = {Pan, Xiao-Hong and He, Shi-Fan and García-Zamora, Diego and Martínez, Luis},
	title = {Interval Type-2 Fuzzy Decision Analysis Framework Based on Online Textual Reviews},
	year = {2023},
	journal = {Advances in Complex Decision Making: Using Machine Learning and Tools for Service-Oriented Computing},
	pages = {66 - 87},
	doi = {10.1201/9781003340621-5},
	url = {https://www.scopus.com/pages/publications/85176348752?origin=resultslist},
	affiliations = {Fuzhou University, Fujian, China; University of Jaén, Jaén, Spain; University of Jaén, Jaén, Spain},
	abstract = {With the popularity of the Internet and the development of social media, the volume of Online Textual Reviews (OTRs) has sharply increased. Even though these reviews offer a valuable source of knowledge to address complex decision situations, the proper modeling of the information contained in the OTRs is still an open problem. In this chapter, a multicriteria decision analysis framework for OTRs based on interval type-2 fuzzy sets is developed. First, the OTRs are processed by data cleaning and transformed into interval type-2 fuzzy distributed structures using sentiment analysis. Then, an interval type-2 fuzzy entropy weight model is applied to determine the criteria weights and, subsequently, the Evidential Reasoning (ER) algorithm is used to fuse the interval type-2 fuzzy distributed information and generate the interval-valued expected utility of each alternative. Afterward, a minimax regret approach is established to rank the obtained interval-valued expected utilities. Finally, a case study is given to illustrate the implementation process of the proposed method. © 2024 selection and editorial matter, Walayat Hussain, Honghao Gao, Fethi Rabhi and Luis Martínez; individual chapters, the contributors.},
