@ARTICLE{Zhu202411813,
	author = {Zhu, Bin and Xu, Panpan and Ren, Peijia},
	title = {Online Information Serves Offline Sales: Knowledge Graph-Based Attribute Preference Learning},
	year = {2024},
	journal = {IEEE Transactions on Engineering Management},
	volume = {71},
	pages = {11813 - 11827},
	doi = {10.1109/TEM.2024.3430380},
	url = {https://www.scopus.com/pages/publications/85199078527?origin=resultslist},
	affiliations = {Beijing Institute of Technology, School of Management, Beijing, 100081, China; Yangtze Delta Region Academy, Jiaxing Key Laboratory of Digital Economy and Data Operations, Beijing Institute of Technology, Jiaxing, 314019, China; Beijing Institute of Technology, School of Management, Beijing, 100811, China; South China University of Technology, School of Business Administration, Guangzhou, 510640, China},
	abstract = {The combination of online and offline shopping is becoming more common. We define the scenario where online information serves offline sales as online-offline scenario. Online and offline shopping each has its own advantages and challenges, making it necessary to integrate the strengths of both online and offline channels. Online platforms can discover consumers' attribute preferences through their online generated data. Since consumers maintain coherent attribute preferences over a period of time in both online and offline, offline salesmen can use the attribute preferences transferred from online platforms to create personalized marketing plans. In this online-offline scenario, it is crucial to learn consumer attribute preferences. We propose a knowledge graph-based multiattribute preference learning method (KG-APL), which integrates knowledge graph (KG) and multiattribute decision-making (MADM) theory. Based on MADM theory, KG-APL can learn multilevel attribute preferences in a data-driven way and provide an explanatory analysis for attribute preferences. The explanations rely on both the MADM theory and rich side information about product contained in the KG. Specifically, MADM describes the consumer's decision-making process and KG provides a hierarchical structure from products to attributes and subattributes. To verify its effectiveness and robustness, we use randomly generated data for experiments and real-life data for simulated decision making. Our article provides insight into the way of achieving integration between online and offline channels and offers theoretical and methodological support in enhance online-offline purchase services.  © 1988-2012 IEEE.},
	author_keywords = {Knowledge graph (KG); multiattribute decision making (MADM); preference learning},
