	year = {2025},
	journal = {2025 5th International Conference on Intelligent Technologies, CONIT 2025},
	pages = {},
	doi = {10.1109/CONIT65521.2025.11167078},
	url = {https://www.scopus.com/pages/publications/105018299539?origin=resultslist},
	affiliations = {Punjabi University, Department of Computer Science and Engineering, Patiala, India; Thapar Institute of Engineering and Technology, Department of Computer Science and Engineering, Patiala, India},
	abstract = {This paper highlights the need for recommendations of similar users on the basis of multiple aspects of hotels such as food, room, location and so on. These aspects are hidden in the hotel reviews and require some productive representation for generating recommendations. This study utilizes a knowledgeable representation of multiple and diverse aspects of hotels from the latent semantics of hotel reviews posted by users on TripAdvisor. The resultant representation is well versed with users' preferences as compared to single overall rating used by traditional methods which is quite uncertain and ambiguous. The derived semantics of reviews are transformed into a 3-D user-hotel-feature matrix fed to an autoencoder network to learn user embeddings and predict the semantic scores from these compressed embeddings. The original 3-D matrix is reconstructed from the predicted semantics and further utilized to compute the mutual information shared between each pair of users in a similarity matrix. The experimental evaluation of predictions of autoencoder model for the defined 3-D matrix and 2-D ratings matrix shows smaller MSE for the 3-D representation of the semantics of hotels. The users sharing higher mutual information score with a particular user are recommended as similar users. This aids the decision-making process of tourism or hotel stakeholders to target different types of users according to the multiple latent aspects of hotels. © 2025 IEEE.},
	author_keywords = {Autoencoder; Deep Learning; Multi-Criteria; Mutual Information; Recommendations; Semantics},
	keywords = {Behavioral research; Decision making; Embeddings; Hotels; Latent semantic analysis; Matrix algebra; Tourism; Auto encoders; D matrixes; Decision-making modeling; Deep learning; Embeddings; Multi aspects; Multi-criteria; Multi-Criterion; Mutual informations; Recommendation; Semantics},
