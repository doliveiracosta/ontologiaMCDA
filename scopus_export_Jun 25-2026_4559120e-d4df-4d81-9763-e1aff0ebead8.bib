	year = {2025},
	journal = {16th International Conference on Information, Intelligence, Systems and Applications, IISA 2025},
	pages = {},
	doi = {10.1109/IISA66859.2025.11311243},
	url = {https://www.scopus.com/pages/publications/105031889974?origin=resultslist},
	affiliations = {Institute of Communication and Computer Systems, NTUA, Athens, Greece; Cluster of Bioeconomy and Environment of Western Macedonia, Kozani, Greece; Institute for European Energy and Climate Policy, Amsterdam, Netherlands; Institute of Communications and Computer Systems, NTUA, Athens, 6701583211, Greece},
	abstract = {Regional energy planning is pivotal for advancing both national and EU climate objectives, particularly amidst escalating climate challenges and the urgent need for a sustainable energy transition. Energy efficiency is central to achieving the EU's climate ambition which is reaffirmed in the recently revised Energy Efficiency Directive (EU/2023/1791). The directive strengthens the legislative framework for the application of the 'Energy Efficiency First' (EE1st) principle, which mandates that cost-effective energy efficiency measures should be prioritized over supply-side investments in energy generation and infrastructure. Despite its policy prominence, embedding the EE1st principle into regional and local planning remains complex. Key challenges include amongst others: lack of awareness and understanding, and lack of technical knowledge and competence. To support this policy-to-practice transition, the REGIO1st project - co-funded by the LIFE Programme - has developed the REGIO1st Planning Framework and accompanying tools to assist regions in aligning their energy strategies with the EE1st principle. Cornerstone to this framework is the Regio1st Multi-Criteria Decision Analysis (MCDA) tool. This tool assists planners in evaluating and prioritizing energy interventions using a transparent, evidence-based methodology grounded in environmental, technical, economic, and social criteria. It also facilitates structured stakeholder feedback, enhancing legitimacy and acceptance of energy strategies. Currently being piloted in six European regions, the REGIO1st Framework is tailored to accommodate diverse regional conditions and planning cultures. This paper presents the conceptual foundations and methodological design of the REGIO1st MCDA tool, exploring its role in facilitating the application of the EE1st principle within a participatory decision-making context. Early insights from pilot implementation are shared, highlighting practical benefits, encountered barriers, and recommendations for wider adoption and refinement.  © 2025 IEEE.},
	author_keywords = {Decision Making; Decision Tools; EE1st principle; Energy Efficiency; Energy Planning; Multi-criteria Decision Analysis; Multi-level governance; Participatory Planning; Regional energy planning;},
	keywords = {Cost effectiveness; Decision theory; Energy policy; Environmental regulations; Investments; Regional planning; Decision tool; Decisions makings; Ee1st principle; Energy; Energy planning; Multi-criteria decision analysis; Multi-level governance; Participatory planning; Regional energy planning;; Decision making; Energy efficiency},
