@CONFERENCE{Deunf2021,
	author = {Deunf, Julian Le and Khannoussi, Arwa and Lecornu, Laurent and Meyer, Patrick and Puentes, John},
	title = {Automatic Data Quality Assessment of Hydrographic Surveys Taking into Account Experts' Preferences},
	year = {2021},
	journal = {Oceans Conference Record (IEEE)},
	volume = {2021-September},
	pages = {},
	doi = {10.23919/OCEANS44145.2021.9705772},
