@CONFERENCE{Diamante2024,
	author = {Diamante, Darius Joseph R. and Promentilla, Michael Angelo B. and Culaba, Alvin B.},
	title = {Systematic Mapping and Analysis of Barriers to Nuclear Power Development in the Philippines: An LLM-Assisted Hierarchical Network Model Approach},
	year = {2024},
	journal = {2024 IEEE 16th International Conference on Humanoid, Nanotechnology, Information Technology, Communication and Control, Environment, and Management, HNICEM 2024},
	pages = {},
	doi = {10.1109/HNICEM64917.2024.11258840},
	url = {https://www.scopus.com/pages/publications/105030197191?origin=resultslist},
	affiliations = {De La Salle University, Department of Mechanical Engineering, 401 Taft Avenue, Manila, 0922, Philippines; De La Salle University, Department of Chemical Engineering, 2401 Taft Avenue, Manila, 0922, Philippines},
	abstract = {The global energy sector faces critical challenges in climate change and energy security, driving the pursuit of cleaner energy sources. In the Philippine context, the country's electricity generation mix is over 77% reliant on fossil fuels. Nuclear power emerges as a promising solution for decarbonization and stable baseload power. The Philippines exemplifies this trend, having recently adopted a national position on nuclear power. To address these challenges, the Philippine Energy Plan 2023-2050 includes nuclear power integration, targeting the commissioning of 1.2 GW by as early as 2032. However, nuclear power development faces numerous challenges as demonstrated by global trends. This study aims to systematically scope current research on nuclear power development, identify key barriers, and evaluate their priorities using multi-criteria decision-making methods. Additionally, it explores the potential of large language models (LLMs) to simulate the complex decision-making process, offering novel insights into energy transition strategies. Through the systematic mapping process, 12 barriers to nuclear power development were gathered from 27 relevant references. A Generative Pre-trained Transformer (GPT) LLM guide was developed to help identify the optimal number of experts needed for the decision problem; generate virtual expert profiles; and prepare the MCDM survey. The virtual experts were developed to act according to their profiles and elicit judgments. Through an AHP-DEMATEL hierarchical network decision model, barrier interdependencies were captured, enhancing barrier prioritization. Nuclear Material Monitoring, Economic and Financial Viability, and Legal and Regulatory Framework barriers emerged as the most crucial for nuclear power development. While the LLM-powered virtual assistants completed the decision-making process in a considerably short span of time (completing 198 pairwise questions in under 5 minutes each), the efficiency in terms of output quality versus less time input could be explored further in succeeding studies. Future research should explore integrating response validation mechanisms and investigate the use of LLM-assisted MCDM data processors to handle large datasets from numerous virtual experts, especially for decision problems with many factors.  © 2024 IEEE.},
