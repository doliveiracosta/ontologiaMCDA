	title = {Towards Sustainable Tourism: A Novel Comprehensive Hierarchical Multi-Criteria Evaluation Framework for Points-of-Interest Recommendations},
	year = {2025},
	journal = {Frontiers in Artificial Intelligence and Applications},
	volume = {410},
	pages = {12 - 21},
	doi = {10.3233/FAIA250570},
	url = {https://www.scopus.com/pages/publications/105021078002?origin=resultslist},
	affiliations = {ITAKA, Dept. Enginyeria Informàtica i Matematiques Universitat Rovira i Virgili, Catalonia, Tarragona, Spain},
	abstract = {The rapid growth of tourism necessitates tools that guide users towards Points of Interest (POIs) that are not only desirable but also sustainable. Current recommendation systems often prioritize popularity or basic user preferences, neglecting crucial environmental, cultural, social, and economic impacts. Addressing this gap, the goal of this work is to facilitate the design of recommendation systems that promote POIs balancing user preferences with positive sustainability outcomes. To this end, this paper introduces a comprehensive, hierarchical framework for multi-criteria evaluation of POIs, enabling a holistic assessment that systematically considers both adequacy to user preferences and trip characteristics, as well as sustainability. The sustainability dimension is further decomposed into environmental, cultural, social, and economic pillars. We define and justify the main levels of this hierarchy, outlining their conceptual scope and rationale for inclusion. To operationalize this framework, we discuss strategies for robust data acquisition-including proxy estimation and Large Language Models-based inference-and propose the need of using hierarchical Multi-Criteria Decision-Making methods, specifically ELECTRE-H, for future aggregation of diverse criteria. This structured foundation is intended to support the future development of recommendation systems that enable more informed and responsible tourism choices.  © 2025 The Authors.},
