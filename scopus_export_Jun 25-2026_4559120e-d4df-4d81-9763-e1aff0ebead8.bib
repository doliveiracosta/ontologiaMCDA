	keywords = {Decision making; Decision support systems; Deep learning; Learning systems; Linguistics; Multi-task learning; Sentiment analysis; Decision making models; Expert evaluation; Linguistic terms; Multi criteria decision making; NAtural language processing; Natural languages; Restaurant reviews; Sources of informations; Quality control},
