@ARTICLE{Abadi20251,
	author = {Abadi, Mohamed and Moore, David R. and Huang, Jieling and Mohandes, Saeed Reza and Ejohwomu, Obuks},
	title = {Embedding circularity assessments in building projects’ frontend decision-making: presenting a compelling behaviour change case},
	year = {2025},
	journal = {Smart and Sustainable Built Environment},
	pages = {1 - 25},
	doi = {10.1108/SASBE-04-2025-0173},
	url = {https://www.scopus.com/pages/publications/105017561268?origin=resultslist},
	affiliations = {Department of Civil Engineering and Management, The University of Manchester, Manchester, United Kingdom; Scott Sutherland School of Architecture and Built Environment, Robert Gordon University, Aberdeen, United Kingdom; CIDB Centre of Excellence, University of Johannesburg, Johannesburg, South Africa},
	abstract = {Purpose – The circular economy (CE) paradigm has helped the building sector reduce its environmental impacts. However, existing circularity assessment (CA) frameworks have not guided practitioners in making circular decisions at the project frontend. This paper develops and validates a CA framework to inform circular decision-making (DM) at an early stage in building projects. Design/methodology/approach – The proposed CA framework, comprising 12 circularity indicators (CIs), was calibrated using the analytic hierarchy process. A state-of-the-art case study, involving a cutting-edge engineering building at the forefront of the sustainability design stage, was undertaken to validate the proposed model and identify potential challenges through the lens of the theory of planned behaviour (TPB). Findings – (1) Current building sustainability assessments lack clear conceptual contours between different pathways to sustainability due to a focus on carbon/energy instead of materials flows; (2) the fragmentation of project roles resulted in a lack of collaborative effort in CA, with designers primarily driven by clients’ requirements and often emphasising traditional sustainability metrics over circularity benefits; and (3) the transition to CE in the built environment has been partial and completing the transition involves a behaviour change case including all stakeholders. Research limitations/implications – This study contributes to the current body of knowledge by revealing behavioural challenges related to CA within the field of circular building design. It supports building designers to embed CA in building projects’ front-end DM. It also refocuses policymakers’ attention to embodied carbon, circular public procurement and economic incentives as levers for driving CA implementation. Originality/value – The validation of a novel set of CIs using a cutting-edge building project case study offers unique insights, underpinned by TPB, into behavioural challenges, relevant to incorporating circularity into frontend DM processes. © 2025 Emerald Publishing Limited},
	author_keywords = {Circular economy; Circularity indicators; Construction circularity assessment; Multiple-criteria decision-making; Theory of planned behaviour},
	keywords = {Analytic hierarchy process; Behavioral research; Circular economy; Construction industry; Cutting; Decision making; Ecodesign; Environmental impact; Structural design; Sustainable building; Sustainable development; Behaviour changes; Building projects; Case-studies; Circular economy; Circularity indicator; Construction circularity assessment; Decisions makings; In-buildings; Multiple criteria decision making; Theory of Planned Behavior; Architectural design; Carbon},
	publisher = {Emerald Publishing},
	issn = {20466099},
	language = {English},
