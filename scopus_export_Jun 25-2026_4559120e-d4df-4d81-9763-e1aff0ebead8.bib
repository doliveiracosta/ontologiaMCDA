	author = {Horstmannshoff, Thomas and Ehmke, Jan Fabian},
	title = {Traveler-oriented multi-criteria decision support for multimodal itineraries},
	year = {2022},
	journal = {Transportation Research Part C: Emerging Technologies},
	volume = {141},
	pages = {},
	doi = {10.1016/j.trc.2022.103741},
	url = {https://www.scopus.com/pages/publications/85132759434?origin=resultslist},
	affiliations = {Management Science Group, Otto von Guericke University Magdeburg, Universitätsplatz 2, Magdeburg, 39106, Germany; Department of Business Decisions and Analytics, University of Vienna, Kolingasse 14-16, Vienna, 1090, Austria},
	abstract = {In recent years, the variety of mobility services has increased strongly. Travelers expect a diverse set of combined mobility services according to multiple individual preferences. Due to the competing characteristics of these preferences (e.g. travel time, price, and the number of transfers), several Pareto-optimal itineraries representing trade-offs arise. While there are efficient approaches for finding multimodal shortest paths, the full set of Pareto-optimal itineraries cannot be determined efficiently when multiple traveler preferences are considered in a large multimodal network. However, this would be required to provide travelers with more relevant choices in the light of available options and complex solution space characteristics. In this work, we propose smart ways to approximate the Pareto front of multimodal itineraries efficiently. The core idea is to apply solution space sampling systematically. We focus on the scalability of the sampling framework with respect to multiple traveler preferences as well as identifying interesting characteristics of itineraries to enable travelers to take well-informed decisions. The framework is evaluated with a large amount of real-world data of mobility services. To this end, we analyze long-distance trips between major cities in Germany, taking up to five most prevalent traveler preferences into account. In addition, we examine the Pareto-optimal solutions and derive characteristics of potential interest for the traveler that can help to make the search more transparent and explainable and thus shape the traveler's choice set. © 2022 Elsevier Ltd},
	author_keywords = {Multi-criteria decision support; Multimodal mobility; Pareto front approximation; Routing},
	keywords = {Decision support systems; Economic and social effects; Pareto principle; Individual preference; Mobility service; Multi-modal; Multicriteria decision support; Multimodal mobility; Pareto front; Pareto front approximation; Pareto-optimal; Routings; Solution space; decision support system; efficiency measurement; multicriteria analysis; routing; transportation development; transportation planning; travel behavior; Travel time},
	correspondence_address = {T. Horstmannshoff; Management Science Group, Otto von Guericke University Magdeburg, Magdeburg, Universitätsplatz 2, 39106, Germany; email: thomas.horstmannshoff@ovgu.de},
	publisher = {Elsevier Ltd},
