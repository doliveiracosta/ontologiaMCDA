	journal = {4th International Conference on Applied Artificial Intelligence and Computing, ICAAIC 2025},
	pages = {1556 - 1562},
	doi = {10.1109/ICAAIC64647.2025.11330965},
	url = {https://www.scopus.com/pages/publications/105034900630?origin=resultslist},
	affiliations = {Panimalar Engineering College, Department of Cse, Chennai, India; Soet, Cmr University, Department of It, Karnataka, Bengaluru, India; Saveetha Engineering College, Department of Artificial Intelligence and Data Science, Thandalam, chennai, India; R.M.K Engineering College, Department of Information Technology, Chennai, India},
	abstract = {Individuals from underserved communities, including students, patients, and rural populations, frequently face significant barriers in accessing support from Non-Governmental Organizations (NGOs) due to the absence of a centralized and intelligent matching platform. To bridge this gap, this paper proposes a novel AI-based recommendation system that efficiently connects users with the most relevant NGOs. The system leverages Natural Language Processing (NLP) to analyze a user's textual description of their needs and automatically classifies the request according to the relevant Sustainable Development Goal (SDG). Subsequently, a Machine Learning (ML) model performs multi-criteria matching, ranking potential NGOs based on their service specialization and geographical proximity to the user. We detail the system's architecture, including the specific NLP models for text classification and the ranking algorithm. Preliminary results demonstrate the system's effectiveness in providing accurate and context-aware recommendations, significantly reducing the search effort for users. This work not only offers a practical tool for enhancing community resource accessibility but also presents a scalable framework for applying AI to public service matching challenges. © 2025 IEEE.},
	author_keywords = {Artificial Intelligence; Community Support Systems; Machine Learning; Natural Language Processing; NGO Recommendation},
