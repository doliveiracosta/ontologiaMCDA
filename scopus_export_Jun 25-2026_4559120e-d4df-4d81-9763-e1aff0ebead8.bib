	affiliations = {Chair of Corporate Environmental Management and Sustainability, Faculty of Economics and Business Administration, University of Technology Chemnitz, Thüringer Weg 7, Chemnitz, 09126, Germany; Chair of Communication - Science and Technology Communication, Institute of Media and Communication, Faculty of Arts, Humanities and Social Science, Technische Universität Dresden, Zellescher Weg 17, Dresden, 01069, Germany; Department of Modelling and Valuation, Helmholtz Institute Freiberg for Resource Technology Resourcentechnologie, Helmholtz Center Dresden Rossendorf e.V., Chemnitzer Str. 40, Freiberg, 09599, Germany; Institute for Stochastics, TU Bergakademie Freiberg, Prüferstraße 9, Freiberg, 09599, Germany},
	abstract = {The integration of sustainability into the early stages of New Product Development (NPD) is critical for fostering innovation and ensuring long-term competitive advantage. This critical review explores, evaluates, and synthesizes the strengths, weaknesses, and gaps in the literature concerning the incorporation of sustainability facets within NPD processes in early innovation phases. Despite the growing emphasis on sustainable practices, significant gaps persist in effectively embedding multi-faceted sustainability approaches, like Multi-Criteria Decision Analysis (MCDA) and other tools, during initial NPD phases. The review reveals that while numerous tools and frameworks exist to enhance sustainability in NPD, their application in early phases is often fragmented and lacks a comprehensive approach. Key barriers include the complexity of sustainability criteria, limited operational tools, data deficiencies, and high costs associated with sustainable practices. Current research predominantly addresses environmental and economic dimensions, with insufficient focus on social, cultural, political, and systemic aspects. The findings underscore the necessity for a multidimensional framework that integrates multi-facets of sustainability. Product-specific MCDAs, methods to manage trade-offs effectively, stakeholder involvement, and industry-specific adaptations of sustainability tools are important, but missing. Future research should aim to develop practical, validated tools that accommodate diverse sustainability dimensions and are adaptable across different sectors. © 2025 The Authors},
	author_keywords = {Multi-criteria decision analysis; New product development; Sustainability diversity; Trade-offs},
	keywords = {Green development; Competitive advantage; Critical review; Embeddings; Multi-criteria decision analysis; Multi-criteria tools; New product development; New product development process; Sustainability diversity; Sustainable practices; Trade off; Product development},
