Editor = {DAmato, C and Fernandez, M and Tamma, V and Lecue, F and CudreMauroux, P and Sequeda, J and Lange, C and Heflin, J},
Title = {Multi-label Based Learning for Better Multi-criteria Ranking of Ontology
   Reasoners},
Booktitle = {SEMANTIC WEB - ISWC 2017, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2017},
Volume = {10587},
