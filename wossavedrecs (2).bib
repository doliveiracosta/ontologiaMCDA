@article{ WOS:001615405400001,
Author = {Shamsi, Mohammad and Mahmoudi, Mohammad Mahdi and Rooholamini, Hamed and
   Motlagh, Nazanin Mahbubi},
Title = {A hybrid fuzzy multi-criteria sustainability framework for incorporating
   recycled tire waste into green concrete technologies: Large scale
   applications of retaining walls and pavements},
Journal = {CONSTRUCTION AND BUILDING MATERIALS},
Year = {2025},
Volume = {500},
Month = {NOV 21},
Abstract = {This study presents an integrated sustainability decision-support
   framework for incorporating recycled tire waste into green concrete (GC)
   for large-scale retaining walls and pavements in moderate-to-cold
   climates. The framework is designed to manage uncertainty, ensure
   reliability, and establish credible multi-criteria decisionmaking
   (MCDM), moving beyond sequential testing by interlinking three
   complementary components: (i) expertdriven weighting of technical,
   economic, and environmental criteria using the fuzzy SIWEC method, (ii)
   experimental evaluation of 15 GC mixtures containing crumb rubber (CR)
   and recycled steel fibers (SFs), and (iii) a multi-method MCDM ranking
   system combining five techniques (DEPART, ARLON, RAWEC, AROMAN, MARCOS),
   aggregated via the Copeland method for cross-validation. SIWEC was
   chosen for its scalability and reduced computational load in handling
   numerous criteria common in construction materials evaluation. The MCDM
   methods offer complementary advantages: DEPART captures subtle mix
   differences via pairwise deviation ratios; ARLON handles exponential
   material property with log normalization; RAWEC provides fast,
   transparent decisions; AROMAN's hybrid normalization reduces unit bias
   (e.g., MPa, cost, kg); and MARCOS resists rank reversal through
   ideal/anti-ideal benchmarking. Results show that performance criteria
   weighting is application-specific. For retaining walls, mechanical
   properties dominated (57 \% weight), with flexural strength most
   critical. For pavements, durability (37 \%) and mechanical performance
   (42 \%) were decisive, with abrasion resistance leading. This shows
   sustainability priorities must align with structural application's
   function. Mixture C5F0.5 ranked highest for retaining walls, while
   C0F0.5 was optimal for pavements. RAWEC correlated most with other MCDM
   methods for retaining walls (over 77.36 \%), while DEPART showed highest
   consistency for pavements (exceeding 68.52 \%), indicating superior
   ranking reliability. Despite minor inconsistencies from ARLON, most
   methods produced consistent rankings. By embedding expert-driven
   weighting, experimental data, and multi-method decision synthesis, this
   framework provides a replicable, generalizable, and validated pathway
   for sustainable GC supply chains.},
Publisher = {ELSEVIER SCI LTD},
