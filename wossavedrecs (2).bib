@article{ WOS:001787120400001,
Author = {Lei, Jianjun and Hu, Dingyuan and Wang, Ying},
Title = {MTF-CLIP: Efficient multimodal action recognition framework exploring
   multi-criteria token fusion},
Journal = {IMAGE AND VISION COMPUTING},
Year = {2026},
Volume = {172},
Month = {AUG},
Abstract = {Recent advancements in large vision-language pretraining models have
   demonstrated considerable promise for video understanding tasks.
   Nevertheless, existing methodologies frequently encounter substantial
   computational costs, which significantly hinder their practical
   implementation. In this paper, we propose a lightweight and efficient
   multimodal adaptation framework that not only achieves state-of-the-art
   recognition accuracy but also markedly reduces computational overhead.
   Specifically, we introduce an innovative adapter-based architecture that
   seamlessly integrates lightweight adapters into a pretrained backbone.
   This design facilitates effective knowledge transfer while maintaining
   the model's representational capacity. Furthermore, we have engineered
   an adaptive token fusion mechanism that utilizes various fusion criteria
   to minimize computational redundancy while preserving critical semantic
   information. To enhance task-specific adaptation, we develop a two-stage
   training strategy that combines knowledge distillation with supervised
   fine-tuning. Comprehensive experimental results validate the
   effectiveness of our approach: on the Kinetics-400 dataset, our model
   achieves a Top-1 accuracy of 84.4\% with a computational requirement of
   only 78 GFLOPs per single-view inference. Additionally, it attains
   zero-shot Top-1 accuracies of 81.2\% on UCF101 and 52.3\% on HMDB51,
   significantly surpassing prior works in the efficiency-accuracy
   trade-off.},
