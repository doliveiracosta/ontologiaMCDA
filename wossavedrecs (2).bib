@inproceedings{ WOS:000571151500112,
Author = {Haque, Enamul and Chiang, Fei},
Editor = {Rudas, IJ and Janos, C and Toro, C and Botzheim, J and Howlett, RJ and Jain, LC},
Title = {Restoring Consistency in Ontological Multidimensional Data Models via
   Weighted Repairs},
