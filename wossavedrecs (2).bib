Title = {A Systematic Mapping Study of LLM Applications in Mobile Device Research},
Booktitle = {WEB AND BIG DATA. APWEB-WAIM 2024 INTERNATIONAL WORKSHOPS, KGMA 2024,
   SEMIBDMA 2024, MADM 2024, AIEDM 2024 AND STBDM 2024},
