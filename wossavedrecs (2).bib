@inproceedings{ WOS:000312855706140,
Author = {Mushtaq, Sajjad Ali and Lohr, Christophe and Gravey, Annie},
Book-Group-Author = {IEEE},
Title = {A Framework for Unified Traffic Dynamic Routing at Private-Public
   Network Border},
Booktitle = {2012 IEEE INTERNATIONAL CONFERENCE ON COMMUNICATIONS (ICC)},
Series = {IEEE International Conference on Communications},
Year = {2012},
Pages = {6442-6447},
Note = {IEEE International Conference on Communications (ICC), Ottawa, CANADA,
   JUN 10-15, 2012},
Organization = {IEEE},
Abstract = {A dynamic decision making framework implementing multi criteria routing
   of multimedia services at private-public network border with access
   technology convergence while offering multi-homed infrastructure is
   presented. Multi Criteria Decision Making (MCDM) theory and Ontology are
   integrated over the platform for addressing the diversity,
   dimensionality along with multiple objectives over distinct planes and
   inter/intra-domain semantics variations issues respectively. A simple
   use-case involving the dynamic decision-based routing at private-public
   network border over the same framework is presented to validate the
   proposed solution. The system gives higher throughput and lower call
   dropping probability with an add-on susceptible delay while offering
   good QoS and QoE.},
