Title = {Multicriteria Analysis of Ontologically Represented Information},
Booktitle = {APPLICATION OF MATHEMATICS IN TECHNICAL AND NATURAL SCIENCES (AMITANS
   `14)},
Series = {AIP Conference Proceedings},
Year = {2014},
Volume = {1629},
