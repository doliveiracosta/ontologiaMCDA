@inproceedings{ WOS:000905056100012,
Author = {Jabreel, Mohammed and Maaroof, Najlaa and Valls, Aida and Moreno,
   Antonio},
Editor = {Torra, V and Narukawa, Y and Nin, J and Agell, N},
Title = {SentiRank: A System to Integrate Aspect-Based Sentiment Analysis
   and Multi-criteria Decision Support},
Booktitle = {MODELING DECISIONS FOR ARTIFICIAL INTELLIGENCE (MDAI 2020)},
Series = {Lecture Notes in Artificial Intelligence},
