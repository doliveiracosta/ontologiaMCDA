@inproceedings{ WOS:000557263400060,
Author = {Li, Pan and Tuzhilin, Alexander},
Book-Group-Author = {Assoc Comp Machinery},
Title = {Latent Multi-Criteria Ratings for Recommendations},
Booktitle = {RECSYS 2019: 13TH ACM CONFERENCE ON RECOMMENDER SYSTEMS},
Year = {2019},
Pages = {428-431},
Note = {13th ACM Conference on Recommender Systems (RECSYS), Copenhagen,
   DENMARK, SEP 16-20, 2019},
Organization = {Assoc Comp Machinery},
Abstract = {Multi-criteria recommender systems have been increasingly valuable for
   helping consumers identify the most relevant items based on different
   dimensions of user experiences. However, previously proposed
   multi-criteria models did not take into account latent embeddings
   generated from user reviews, which capture latent semantic relations
   between users and items. To address these concerns, we utilize
   variational autoencoders to map user reviews into latent embeddings,
   which are subsequently compressed into low-dimensional discrete vectors.
   The resulting compressed vectors constitute latent multi-criteria
   ratings that we use for the recommendation purposes via standard
   multi-criteria recommendation methods. We show that the proposed latent
   multi-criteria rating approach outperforms several baselines
   significantly and consistently across different datasets and performance
   evaluation measures.},
