@article{ WOS:001637998100001,
Author = {Liu, Fan and Liao, Huchang and Dias, Luis C.},
Title = {Multi-period medical user generated content fusion for physician rating
   based on preference disaggregation},
Journal = {APPLIED SOFT COMPUTING},
Year = {2026},
Volume = {187},
Month = {FEB},
Abstract = {Choosing the right product or service in online platforms based on
   massive, fast-changing user-generated content (UGC) is challenging.
   Prior studies often ignore automatic information extraction and the
   temporal dynamics of UGC, making it difficult to translate text reviews
   into reliable ratings. Considering the choice of a physician as a
   motivating case, this study proposes an UGC-driven physician-ranking
   framework that combines natural language processing techniques with
   multi-criteria decision-making methods. First, the evaluations of the
   physicians on multiple criteria are obtained from the UGC by using a
   hierarchical Dirichlet process topic model, an ERNIEbased unified
   information extraction model for aspect-level sentiment polarity, and a
   qualifier lexicon for sentiment intensity, requiring minimal manual
   preprocessing. In this process, time-based discounting is applied to
   older reviews, to reflect that the older a review is, the less relevant
   it is. A non-compensatory aggregation method based on the ELECTRE TRI
   rating method and probabilistic linguistic term sets is proposed to fuse
   user evaluation information. To set the parameters of this model, a
   preference disaggregation model is established to learn the evaluation
   criteria importance, leveraging users' overall satisfaction and
   preferences. Using data from haodf.com, our empirical study identifies
   the criteria that drive overall satisfaction and offers actionable
   insights for physicians and managers. Four comparative experiments show
   that our method produces more temporally stable physician rankings and
   improves performance relative to benchmark approaches.},
