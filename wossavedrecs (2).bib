@article{ WOS:001767621700001,
Author = {Gholamizadeh, Kamran and Pasman, Hans J.},
Title = {HERO: A hybrid expert-relational ontology framework for robust
   decision-making in the risk management of socio-technical systems},
Journal = {RELIABILITY ENGINEERING \& SYSTEM SAFETY},
Year = {2026},
Volume = {275},
Number = {2},
Month = {NOV},
Abstract = {Socio-technical systems of systems are exposed to cascading risks driven
   by interdependent technical, human, and organizational factors. Under
   time pressure and data scarcity, conventional risk assessment and static
   compromise-seeking MCDM methods determine decision priority rankings of,
   e.g., risk-reducing options, often fail to capture feedback loops,
   hidden correlations, and the diversity of expert judgments. This study
   develops a Hybrid Expert-Relational Ontology (HERO) decision-support
   framework for prioritizing event risk factors and designing mitigation
   portfolios in hazardous-material facilities. HERO is organized as a
   three-stage workflow, in which data science methods are applied. Stage 1
   performs multivariate expert elicitation and entropy-normalized
   credibility weighting using Shannon, Renyi, and Tsallis measures across
   age, experience, education, relevance, and stature, supported by
   QUBO-based optimization and expert similarity/consistency checks. Stage
   2 identifies influencing and criterion parameters, constructs a directed
   dependency graph, derives factor weights via PageRank, and applies
   quadratic Laplacian regularization (QIME-DGW). Stage 3 builds a factors
   versus criteria matrix, extracts the topology of the criterion space
   using persistent homology and Betti numbers, applies dimensionality
   reduction and clustering to quantify coherence and interaction strength,
   and propagates uncertainty through multiverse simulation to evaluate
   robustness across plausible futures and derive intervention strategies.
   A hydrogen-infrastructure emergency-response case study demonstrates the
   framework. Validation against observations is not possible, so HERO is
   benchmarked against conventional MCDM baselines, while stability
   analyses under resampling and multiverse perturbations indicate coherent
   preservation of the top-k set rankings. The hydrogen facility hazard
   example result, eliciting 25 experts who ranked 72 risk factors, makes
   sense.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
