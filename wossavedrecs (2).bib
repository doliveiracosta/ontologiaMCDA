Organization = {ISEG Lisbon School of Economics and Management; Information and
   Technology Management Association},
Abstract = {This systematic mapping addressed a significant research gap by
   integrating ontology and multi-criteria methods to facilitate
   decision-making. The study utilized the Scopus and Web of Science (WoS)
   databases to review research conducted between 2013 and the present,
   focusing on seminal articles supported by robust citations and recent
   relevance. The analysis involved using specialized software and
   platforms, such as VOSviewer, RStudio, and Bibliometrics, to stratify
   and interpret bibliometric data. This approach enabled the
   identification of emerging research trends, key journals driving this
   field of knowledge, notable authors dedicated to this area, and global
   interactions among various research groups. A script written in the R
   language facilitated the identification of forty-one duplicated
   documents across the analyzed databases.},
