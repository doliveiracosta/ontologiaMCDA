@article{ WOS:001742420200001,
Author = {Song, Anbin and Zhu, Yuming},
Title = {Preference Inference-Based Minimum Utility Loss Model for Multi-criteria
   Group Decision-Making with Fairness Concerns},
Journal = {GROUP DECISION AND NEGOTIATION},
Year = {2026},
Volume = {35},
Number = {2},
Month = {APR 16},
Abstract = {In multi-criteria group decision-making (MCGDM), decision makers often
   hold heterogeneous preferences, leading to varied perceptions of
   fairness and acceptability for consensus solutions. To address this,
   this study develops a two-stage consensus framework that first
   transforms ordinal rankings into personalized cardinal utilities and
   then minimizes collective dissatisfaction. The initial stage employs a
   preference inference model that converts individual rankings into
   piecewise-linear marginal value functions. This model ensures
   interpretability by transparently quantifying adjustments to
   inconsistent rankings while selecting the most discriminative function
   to capture individual preference intensity. The subsequent stage
   synthesizes these utilities through a minimum utility loss model, which
   jointly reduces total utility loss and disparities among decision
   makers, thereby explicitly embedding fairness into the consensus
   outcome. Applied to a rural land transfer case in China, the method
   demonstrates how intuitive preference inputs can be rigorously
   transformed into equitable and efficient group choices, yielding a
   structured approach for collective decision-making in fairness-sensitive
   contexts.},
