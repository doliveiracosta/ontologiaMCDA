@article{ WOS:001786714400001,
Author = {Asadi, Mohammad Reza and Paydar, Mohammad Mahdi and Hosseini, Seyyed
   Mehdi},
Title = {A novel text mining-driven decision-making approach for sustainable
   agritourism centre selection},
Journal = {TOURISM RECREATION RESEARCH},
Year = {2026},
Month = {2026 JUN 9},
Abstract = {This paper examines key criteria for selecting Agritourism Centers
   (ACs), which play a vital role in developing agricultural tourism. Based
   on the experts' opinions, influential criteria are first extracted from
   the literature review. A novel hybrid text-mining-based multi-criteria
   decision-making approach is applied. Tourist reviews are categorised
   using a Large Language Model (LLM), and the scores of qualitative
   criteria extracted through text mining are integrated into the decision
   matrix. Based on the findings, practical managerial recommendations are
   provided to help AC managers and relevant stakeholders improve
   decision-making and enhance agritourism performance.},
