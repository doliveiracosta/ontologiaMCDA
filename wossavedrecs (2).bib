@article{ WOS:001724798700001,
Author = {Ozkurt, Cem},
Title = {Explainable AI for interpreting decision processes in multi-criteria
   decision making for robotic systems},
Journal = {KNOWLEDGE-BASED SYSTEMS},
Year = {2026},
Volume = {340},
Month = {MAY 12},
Abstract = {In this study, to simultaneously evaluate diverse technical and
   operational criteria in the selection of industrial robotic arms,
   conventional and fuzzy Multi-Criteria Decision-Making (MCDM) methods
   such as Fuzzy EDAS, Fuzzy TOPSIS, CODAS, and TOPSIS were employed.
   Criteria weights were determined using the Best-Worst Method (BWM), and
   the influence of robotic arm features on MCDM results was further
   analyzed through machine learning algorithms (Decision Tree, Random
   Forest, CatBoost, XGBoost, and Gradient Boosting). Among all models, the
   XGBoost algorithm achieved the highest predictive performance,
   particularly for the CODAS method (MAE = 0.0150, MSE = 0.000488, R2 =
   0.9051), while also providing the best results for TOPSIS (MAE = 0.0286,
   MSE = 0.0150, R2 = 0.8936), Fuzzy TOPSIS (MAE = 0.0286, MSE = 0.0150, R2
   = 0.8936), and Fuzzy EDAS (MAE = 0.0187, MSE = 0.000603, R2 = 0.9231).
   Explainable AI (XAI) techniques such as SHAP and DALEX revealed that
   Weight was the most influential parameter in the CODAS method, whereas
   Weight and Reachability jointly dominated the outcomes of TOPSIS, Fuzzy
   TOPSIS, and Fuzzy EDAS. This study contributes a novel integration of
   XAI with MCDM in robotic arm selection, ensuring methodological
   soundness and delivering practical decision-support value to enhance
   transparency and reliability in industrial decision-making.},
