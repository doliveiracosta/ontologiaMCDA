@article{ WOS:000207620700001,
Author = {Zeng, Y. and Trauth, K. M.},
Title = {Internet-Based Fuzzy Multicriteria Decision Support System for Planning
   Integrated Solid Waste Management},
Journal = {JOURNAL OF ENVIRONMENTAL INFORMATICS},
