@article{ WOS:001730190000001,
Author = {Li, Yuanyuan and Zhang, Zhuo},
Title = {Global systematic review of sustainability assessment for contaminated
   site remediation: A bibliometric visualization approach},
Journal = {JOURNAL OF ENVIRONMENTAL CHEMICAL ENGINEERING},
Year = {2026},
Volume = {14},
Number = {3},
Month = {JUN},
Abstract = {Sustainability assessment of contaminated site remediation serves as a
   critical foundation for transitioning from risk management to
   comprehensive sustainable development. However, current research on
   sustainability assessment methods for contaminated site remediation is
   characterized by methodological diversity and fragmented research
   subjects. The absence of systematic knowledge frameworks, intrinsic
   connections, and research tracks hinders researchers from clarifying the
   field's scope and understanding its developmental path. Unlike
   traditional narrative reviews, this study utilizes bibliometric
   visualization to map the knowledge topology of the field from 1994 to
   2024, aiming to move utilizing knowledge graph visualization to reveal
   the field's knowledge structure, evolutionary dynamics, and latent gaps.
   Findings indicate that sustainability-oriented management and
   decision-making, technology-driven quantification of environmental
   impacts, and assessment frameworks bridging theory and practice
   constitute the primary research directions, which are mutually
   interconnected. Research hotspots in sustainability assessment are
   shifting from method development toward integrated application. Current
   frontiers include combining life cycle assessment with multi objective
   decision analysis, optimizing indicator systems and weighting allocation
   methods, and utilizing machine learning for predicting and optimizing
   remediation strategies. Future research should integrate sustainability
   assessments with national policies, enhance model reliability and data
   quality, and strengthen interdisciplinary collaboration. The results
   provide not only a structural academic map for researchers to position
   their work but also evidence-based insights for funders and policymakers
   to identify key investment areas and advance sustainable remediation
   from concept toward standardized practice.},
