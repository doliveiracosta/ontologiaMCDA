@article{ WOS:001599985500001,
Author = {Khan, Taushif and Toufiq, Mohammed and Yurieva, Marina and Indrawattana,
   Nitaya and Jittmittraphap, Akanitt and Kosoltanapiwat, Nathamon and
   Pumirat, Pornpan and Sukphopetch, Passanesh and Vanaporn, Muthita and
