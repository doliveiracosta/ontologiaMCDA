@article{ WOS:001791079500002,
Author = {Li, Yue and Chen, Zhijun and Hu, Min and Li, Xinyi and Han, Yufei and
   Ren, Dongyang and Xu, Xu and Xiong, Yunwu and Huang, Quanzhong and
   Huang, Guanhua},
Title = {A novel hybrid modeling-based artificial intelligence agent for
   water-food-ecology-environment-economy system trade-offs},
Journal = {JOURNAL OF HYDROLOGY},
Year = {2026},
Volume = {677},
Number = {A},
Month = {SEP},
Abstract = {The mismanagement of irrigation, fertilization, and cropping systems
   intensifies conflicts within the Water-FoodEcology-Environment-Economy
   (WFEEE) system. To address this challenge, we developed a novel
   artificial intelligence (AI) Agent by integrating agro-hydrological
   model (AHC), machine learning algorithm, multi-criteria decision-making
   (MCDM) method, and large language model (LLM) for WFEEE system
   trade-offs, within an AI development platform. The AI Agent can
   automatically optimize irrigation, fertilization, and crop planting
   structures by balancing irrigation water productivity (IWP), crop yield,
   ecosystem service value (ESV), nitrogen pollution load (NPL), and
   economic benefit (EB). Applied to the Wuliangsuhai lake watershed of
   North China under 90 combined irrigation, nitrogen application and
   hydrological year scenarios, along with 8 planting structure scenarios,
   the AI Agent demonstrated significant improvements in sustainability of
   the WFEEE system by strategically reducing irrigation and nitrogen
   inputs while optimizing wheat-to-maize ratio. Compared to conventional
   practices, the AI-driven solution increased IWP by 65\%, reduced NPL by
   78\% and negative ESV by 20\%, while limiting yield and EB losses below
   10\% and 2\%, respectively. As a result, the WFEEE system's
   sustainability index improved by 145\%. Notably, the AI Agent achieved a
   5.7- to 11.5-fold increase in decisionmaking efficiency over traditional
   externally linked approaches, and a 2.6- to 3.7-fold higher stability of
   decision outcomes over conventional MCDM-based single-layer decision.
   These improvements stem from the AI Agent automating previously manual
   tasks (including model execution, decision indicator calculation, data
   format conversion and transmission) and incorporating an LLM-based
   second-layer decision. This study underscores the capability of AI Agent
   to support intelligent management in complex agricultural systems,
   providing a practical pathway for future advancements.},
