@inproceedings{ WOS:000450045100078,
Author = {Kazadi, Yannick Kazela and Fonou-Dombeu, Jean Vincent},
Editor = {Kumar, V and Singh, UG and Sudarsan, SD},
Title = {Complexity Based Ranking of Biomedical Ontologies},
Booktitle = {2016 THIRD INTERNATIONAL CONFERENCE ON ADVANCES IN COMPUTING,
   COMMUNICATION AND ENGINEERING (ICACCE 2016)},
Year = {2016},
Pages = {455-460},
Note = {3rd International Conference on Advances in Computing, Communication and
   Engineering (ICACCE), Durban, SOUTH AFRICA, NOV 28-29, 2016},
Organization = {IEEE S Africa Sect},
Abstract = {A large number of ontologies representing domains of knowledge are
   accessible on the internet and there is an increasing need for
   evaluating and assessing their features. Ontology complexity is
   considered as one of the features to monitor and improve the structure
   of a given ontology. Despite the fact that many complexity metrics have
   been proposed, to our best knowledge no study has focused on ranking
   ontologies based on their level of complexity. This study ranks a set of
   25 biomedical ontologies based on their level of complexity. The
   complexity level of an ontology is determined through the computation of
   8 complexity metrics and the metrics values are used as input of
   Multi-Attributes Decision Making (MADM) methods to get a score
   representing the level of complexity.},
