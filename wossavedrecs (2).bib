Title = {Towards Sustainable Energy Consumption Evaluation in Europe for
   Industrial Sector Based on MCDA Methods},
Booktitle = {KNOWLEDGE-BASED AND INTELLIGENT INFORMATION \& ENGINEERING SYSTEMS (KSE
   2021)},
Series = {Procedia Computer Science},
Year = {2021},
