@article{ WOS:001784314700001,
Author = {Rehman, Ubaid ur and Mahmood, Tahir and Waqas, Hafiz Muhammad},
Title = {Evaluation and ranking of data preprocessing techniques through hesitant
   bipolar fuzzy MCDM approach based on Einstein operators},
Journal = {COMPUTATIONAL \& APPLIED MATHEMATICS},
Year = {2026},
Volume = {45},
Number = {10},
Month = {JUN 4},
Abstract = {In the era of big data, the performance of machine learning is highly
   sensitive to data preprocessing techniques. However, the evaluation and
   ranking of the data preprocessing techniques is still difficult because
   of multiple, multidimensional criteria that include uncertainty,
   hesitancy, and bipolarity. The current fuzzy multi-criteria
   decision-making (MCDM) models are usually constrained in the capability
   of concurrently modeling bipolar information and hesitation, which
   results in the loss of information and unreliable decision-making. To
   overcome these shortcomings, this paper presents a new hesitant bipolar
   fuzzy MCDM model using Einstein aggregation operators (AOs) to evaluate
   and select data preprocessing methods. The primary novelty of the work
   is that Einstein averaging and geometric AOs are developed in the
   hesitant bipolar fuzzy (HBF) environment, which allows information to be
   more easily fused and less sensitive to extreme evaluations. The
   developed framework maintains both positive and negative hesitant
   information during the aggregation process, which leads to more
   expressive and realistic modeling of expert judgments. Also, the
   proposed operators have desirable mathematical properties, which
   guarantee consistency and strength in decision analysis. A practical
   case study associated with the evaluation of preprocessing techniques is
   performed to prove the effectiveness and applicability of the proposed
   method. The comparative analysis of the proposed framework with the
   existing fuzzy aggregation-based MCDM methods proves that the proposed
   framework offers more consistent and explainable ranking outcomes. The
   suggested methodology provides a systematic and versatile
   decision-support system to machine learning practitioners and can be
   easily applied to other complex decision-making scenarios that involve
   uncertainty, bipolarity, and hesitation.},
