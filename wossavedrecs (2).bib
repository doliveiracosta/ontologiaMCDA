@article{ WOS:001784114700001,
Author = {Bharti, Surbhi and Singh, Somya and Birla, Vidya and Gelam, Arshiya and
   Kumar, Ashwni},
Title = {Enhancing E-Commerce Trust: Integrating Fraud Detection with Sentiment
   Analysis and MCDM},
Journal = {REVIEW OF SOCIONETWORK STRATEGIES},
Year = {2026},
Month = {2026 JUN 4},
Abstract = {Online reviews have become a major source for purchasers' decisions,
   with the rise of e-commerce platforms. However, the increasing
   occurrence of deceptive actions impacts negatively on reality and
   reputation for the credibility accorded to these reviews. This research
   augments previous works that only examined sentiment analysis
   (qualitative measure) and product ratings (quantitative measure) for
   Multi-Criteria Decision Making (MCDM). The fraud detection system helps
   us to effectively detect false reviews so that product rankings are
   accurate and dependable. Although emotions and evaluations enable the
   assessment of opinions and general quality, they fail to consider
   truthfulness. The recommended model contains an integrated deception
   identification system to verify that the review is original before
   assigning it a certain level of deception. By minimising the effect of
   false reviews, this method improves the trustworthiness of various
   products when ranked. It's about giving shoppers reliable data that
   helps them make better choices regarding buying items online. According
   to our analysis, including fraud detection in ranking algorithms is
   critical to ensuring a secure and accurate review system that allows
   customers to make informed choices based on real reviews.},
