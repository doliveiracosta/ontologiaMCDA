@article{ WOS:001437057900001,
Author = {Lin, Song-Shun and Shen, Shui-Long and Zhou, Annan and Chen, Xiang-Sheng},
Title = {Smart Techniques Promoting Sustainability in Construction Engineering
   and Management},
