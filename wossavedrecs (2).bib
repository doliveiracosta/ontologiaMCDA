@article{ WOS:001717964400001,
Author = {Eddy, Douglas and Dunbar, Daniel and Blackburn, Mark and Grosse, Ian and
   Hagedorn, Thomas},
Title = {Integration of Well-Formed Semantic Mapping to Extract System
   Optimization Information},
Journal = {SYSTEMS ENGINEERING},
Year = {2026},
Month = {2026 MAR 19},
Abstract = {Systems that are typically modeled within SysML are complex and not
   easily represented in their full semantic context. Furthermore, model
   complexity poses challenges to rapid and optimal decision making early
   in a system development process without significant trial and error.
   There are some cases where representative data can be obtained to
   characterize a complex system's overall performance. For such cases,
   this work introduces a method grounded in the fundamentals of rigorous
   decision-based design principles by its integration within a semantic
   Interoperability and Integration Framework (IoIF) that interfaces with
   SysML for digital engineering of complex system models. Salient features
   include simplified formulation of SysML model information to conform to
   fundamental principles. This resulting Best System Selection (BestSys)
   method utilizes data that represents any system-of-interest along with
   its requirements information within SysML to identify the best option.
   The method also constructs a surrogate model from the data to find a
   potential better solution in the trade space not located at a data
   point. The workflow further maps that system's information within IoIF
   in a way that may enable SPARQL queries and consistently meaningful
   visualizations.},
