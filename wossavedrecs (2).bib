@inproceedings{ WOS:000468499303084,
Author = {Suzuki, Takafumi and Oyama, Satoshi and Kurihara, Masahito},
Editor = {Abe, N and Liu, H and Pu, C and Hu, X and Ahmed, N and Qiao, M and Song, Y and Kossmann, D and Liu, B and Lee, K and Tang, J and He, J and Saltz, J},
Title = {Toward Explainable Recommendations: Generating Review Text from
   Multicriteria Evaluation Data},
Booktitle = {2018 IEEE INTERNATIONAL CONFERENCE ON BIG DATA (BIG DATA)},
Series = {IEEE International Conference on Big Data},
Year = {2018},
Pages = {3549-3551},
