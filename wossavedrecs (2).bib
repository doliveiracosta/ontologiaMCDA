@article{ WOS:001723045700013,
Author = {Putnoki, Attila Marton and Philipp, Dora and Orosz, Tamas},
Title = {Cognitive Information System Alignment-Aware Decision-Support Framework},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {42794-42808},
Abstract = {In dynamic business environments, effective decision-making depends not
   only on computational performance but also on the alignment between
   system-generated recommendations and the cognitive processes of
   decision-makers. While Business Intelligence and Artificial Intelligence
   enhance data-driven analysis within Cognitive Information Systems,
   insufficient attention has been given to formally modelling this
   alignment dimension. This paper introduces the Cognitive Information
   System Alignment-Aware Decision-Support Framework, a structured
   multi-layer architecture that explicitly separates normative evaluation,
   explicit preference representation, and alignment assessment. Within
   this architecture, Cognitive Resonance is formalised as a diagnostic
   alignment construct that quantifies the correspondence between
   recommended decision alternatives and decision-maker preferences. The
   formulation preserves analytical independence between ranking logic and
   alignment measurement, thereby preventing conflation of decision quality
   with preference correspondence. An illustrative simulation-based use
   case demonstrates the structural feasibility of embedding the alignment
   model into a dashboard-based Cognitive Information Systems environment
   and integrating normative scoring with an optional temporal learning
   component. The results show that ranking outcomes and alignment values
   may vary independently under changing evaluation configurations,
   highlighting the diagnostic value of explicit alignment modelling. The
   proposed architecture contributes a configurable and interpretable
   alignment-aware layer that complements existing multi-criteria and
   learning-based decision-support approaches, providing a structured
   foundation for preference-sensitive and transparent decision-making in
   organisational contexts.},
