Title = {Version {[}1.2]- {[}pyrepo-mcda - Reference Objects based MCDA Software
   Package]},
Journal = {SOFTWAREX},
Year = {2023},
Volume = {24},
Month = {DEC},
Abstract = {This paper presents an update of the pyrepo-mcda Python package,
   providing a broad set of multi-criteria methods and methods supporting
   decision analysis, such as determining compromise rankings, criteria
   weights, distance metrics, and performing sensitive analysis. The
   pyrepo-mcda package was extended with the Vector Measure Construction
   Method (VMCM). This update expands the scope of multi-criteria analysis
   approaches offered by the proposed package. Several features of the VMCM
   method, such as considering non-typical objects, the possibility of
   individual defining patterns, and classifying evaluated objects, are
   sought by decision-makers in many decision-making problems, especially
   sustainability assessment.},
