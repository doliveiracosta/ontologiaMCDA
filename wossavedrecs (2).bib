@inproceedings{ WOS:000425924400134,
Author = {Haddar, Imane and Raouyane, Brahim and Bellafkih, Mostafa},
Book-Group-Author = {IEEE},
Title = {Generating a Service Broker Framework for Service Selection and
   SLA-based Provisioning Within Network Environments},
Booktitle = {2017 NINTH INTERNATIONAL CONFERENCE ON UBIQUITOUS AND FUTURE NETWORKS
   (ICUFN 2017)},
