@article{ WOS:001598125300001,
Author = {Prasetya, Andre and Riadi, Achmad and Muzhoffar, Dimas Angga Fakhri and
   Muhammad, Akbar Wibawa},
Title = {Optimizing run-of-river small hydropower plants through environmental
   flow regulation using ANN, RSM, and MCDM: a case study in Indonesia},
Journal = {SUSTAINABLE ENERGY TECHNOLOGIES AND ASSESSMENTS},
Year = {2025},
Volume = {83},
Month = {NOV},
Abstract = {Run-of-River Small Hydropower Plants (RoR SHPs) provide sustainable
   electricity but may threaten river ecosystems by altering flow regimes.
   This study develops a flexible framework to optimize RoR SHP operations,
   balancing energy generation with ecological preservation. Ten
   Environmental Flow Methods (EFMs) were assessed using Artificial Neural
   Networks (ANN), Response Surface Methodology (RSM), and a Multi-Criteria
   Decision-Making (MCDM) framework combining Entropy Weight Method and
   TOPSIS. ANN achieved the best accuracy (R2 = 0.9602; MAPE = 5.12 \%),
   outperforming RSM (R2 = 0.9466; MAPE = 6.02 \%) and a PCA-based
   regression benchmark (R2 = 0.9453; MAPE = 6.03 \%). Among the scenarios,
   EFM7-allocating a minimum flow of 0.9 m3/s based on the lowest annual
   discharge-scored highest in TOPSIS (0.7650 for ANN; 0.7825 for RSM),
   achieving an effective balance between ecological flow and power
   generation (294 kW with ANN; 305 kW with RSM). The framework's novelty
   lies in integrating high-resolution hydrological data, advanced
   predictive modeling, and structured decision analysis into a unified
   platform, which is rarely applied in SHP research. The findings provide
   a replicable strategy for sustainable SHP operation, supporting
   renewable energy transitions and SDGs 7, 13, and 14. Future work should
   add ecological indicators, longer-term datasets, and hybridization with
   PV and storage to strengthen resilience.},
