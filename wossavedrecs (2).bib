@inproceedings{ WOS:001551802700061,
Author = {Moro Eisvogel, Igor Vinicius and Rocha Loures, Eduardo de Freitas and
   Gomes, Simone and Francisco, Rosemary and Freire, Roberto Zanetti},
Editor = {Sormaz, DN and Bidanda, B and Alhawari, O and Geng, Z},
Title = {Multicriteria Approach for Competence Management in Maintenance within
   Industry 4.0},
Booktitle = {INTELLIGENT PRODUCTION AND INDUSTRY 5.0 WITH HUMAN TOUCH, RESILIENCE,
   AND CIRCULAR ECONOMY, ICPR AMERICAS 2024},
Series = {Lecture Notes in Production Engineering},
Year = {2025},
Pages = {675-686},
Note = {12th International Conference on Production Research, Americas
   region-ICPR Americas, Athens, OH, JUL 21-25, 2024},
Organization = {Ohio University},
Abstract = {In the context of Industry 4.0, marked by significant technological
   advancements, there is a profound transformation in the landscape of
   work. At the core of this evolution lies the critical role of
   competencies, particularly in the domain of maintenance, which emerges
   as a vital component in navigating the transition to more autonomous and
   technologically advanced work environments. This work explores the
   intricate relationship between maintenance and competencies within
   Industry 4.0, underscoring their essential role in shaping the workforce
   and operational methodologies. Building upon an ontology developed for
   work in the 4.0 era, a literature review was conducted and crafted a
   competency management framework tailored for maintenance to further
   advance this approach, resulting in an ontology with a maintenance
   focus. To establish this ontology's connection to maintenance and
   competencies, The PROMETHEE II method, a multicriteria decision support
   tool, was applied to analyze the interaction between maintenance
   pillars, maintenance indicators, and ontology competency concepts.
   Through dialogues with maintenance experts, we devised two matrices that
   scrutinize maintenance pillars and critical indicators concerning
   competencies. The findings underscore the importance of continuously
