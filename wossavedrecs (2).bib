@article{ WOS:001760927400001,
Author = {Lygerakis, Filippos and Kampelis, Nikolaos and Kolokotsa, Dionysia},
Title = {Smart, data-driven decision support for neighborhood-scale energy
   retrofit planning☆},
Journal = {ENERGY AND BUILDINGS},
Year = {2026},
Volume = {362},
Month = {JUL 1},
Abstract = {The transition toward low-carbon and resilient built environments
   requires scalable decision-support frameworks that extend beyond
   individual buildings to the neighborhood level. However, existing
   retrofit planning approaches often rely on fragmented datasets and
   tightly coupled simulation workflows that limit interoperability and
   transparency in decision-making processes. This study proposes an
   ontology-driven Knowledge Graph (KG) architecture to support
   data-driven, stakeholder-oriented decision making for neighborhood-scale
   retrofit planning. The framework semantically structures neighborhood
   assets, operational datasets, retrofit scenarios, and performance
   indicators within a unified KG that acts as an interoperability layer
   connecting heterogeneous data sources and analytical tools. Within this
   framework, retrofit intervention scenarios can be evaluated through any
   combination of external assessment methods such as energy simulations,
   life cycle cost (LCC), and life cycle assessment (LCA). The multi-domain
   indicators are semantically integrated into the KG and retrieved through
   SPARQL queries, enabling multi-criteria assessment of retrofit
   alternatives and transparent traceability between scenario assumptions,
   performance metrics, and stakeholder preferences. A multi-criteria
   decision analysis using PROMETHEE II is explored to perform
   preference-driven scenario ranking for different stakeholder profiles.
   The methodology is demonstrated through a real-world campus-scale case
   study at the Technical University of Crete, where photovoltaic and
   photovoltaic-battery retrofit scenarios are assessed using measured
   operational data. The results illustrate how the proposed KG-based
   architecture enables interoperable integration of datasets, simulation
   outputs, and decision-support analytics, supporting transparent and
   scalable stakeholder-oriented retrofit planning at the neighborhood
   scale.},
