@inproceedings{ WOS:000231849800062,
Author = {Plantié, M and Montmain, J and Dray, G},
Editor = {Andersen, KV and Debenham, J and Wagner, R},
Title = {Movies recommenders systems: Automation of the information and
   evaluation phases in a multi-criteria decision-making process},
Booktitle = {DATABASE AND EXPERT SYSTEMS APPLICATIONS, PROCEEDINGS},
Series = {Lecture Notes in Computer Science},
Year = {2005},
