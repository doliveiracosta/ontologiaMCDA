@article{ WOS:001513410000005,
Author = {Hunger, Tom and Arnold, Marlen Gabriele and Engesser, Sven and van den
   Boogaart, K. Gerald},
Title = {Integrating sustainability facets into the early stages of new product
   development using multi-criteria tools - a critical review},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2025},
Volume = {517},
Month = {JUL 25},
Abstract = {The integration of sustainability into the early stages of New Product
   Development (NPD) is critical for fostering innovation and ensuring
   long-term competitive advantage. This critical review explores,
   evaluates, and synthesizes the strengths, weaknesses, and gaps in the
   literature concerning the incorporation of sustainability facets within
   NPD processes in early innovation phases. Despite the growing emphasis
   on sustainable practices, significant gaps persist in effectively
   embedding multi-faceted sustainability approaches, like Multi-Criteria
   Decision Analysis (MCDA) and other tools, during initial NPD phases. The
   review reveals that while numerous tools and frameworks exist to enhance
   sustainability in NPD, their application in early phases is often
   fragmented and lacks a comprehensive approach. Key barriers include the
   complexity of sustainability criteria, limited operational tools, data
   deficiencies, and high costs associated with sustainable practices.
   Current research predominantly addresses environmental and economic
   dimensions, with insufficient focus on social, cultural, political, and
   systemic aspects. The findings underscore the necessity for a
   multidimensional framework that integrates multi-facets of
   sustainability. Product-specific MCDAs, methods to manage trade-offs
   effectively, stakeholder involvement, and industry-specific adaptations
   of sustainability tools are important, but missing. Future research
   should aim to develop practical, validated tools that accommodate
   diverse sustainability dimensions and are adaptable across different
   sectors.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
