@article{ WOS:001573626800001,
Author = {He, Fengyi and Su, Xiaoming and Li, Ruihua and Zheng, Binyan and Yang,
   Yan},
Title = {Advancing Multi-Objective Optimization in Cable Circuit Design Using
   Knowledge Graph-Based Framework},
