@article{ WOS:000865441700004,
Author = {Watrobski, Jaroslaw and Baczkiewicz, Aleksandra and Salabun, Wojciech},
Title = {Version {[}1.1]-{[}pyrepo-mcda - Reference Objects based MCDA Software
   Package]},
Journal = {SOFTWAREX},
Year = {2022},
Volume = {19},
Month = {JUL},
Abstract = {This paper presents the consolidation and extension of two developed
   Python packages for multi -criteria decision analysis (MCDA). The
   pyrepo-mcda package providing a set of MCDA methods and supporting
   techniques such as compromise rankings and sensitivity analysis has been
   consolidated with the Crispyn package providing a broad set of objective
   criteria weighting methods. Then, the package was supplemented with
   seven additional MCDA methods. The extension of the pyrepo-mcda package
   significantly expands its analytical capabilities. Additional MCDA
   methods, especially those supporting the strong sustainability paradigm,
   increase the scope of applications of the package for reliable
   sustainability assessment. (C) 2022 The Author(s). Published by Elsevier
