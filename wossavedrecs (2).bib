@inproceedings{ WOS:000407136100044,
Author = {Liu, Liwei and Lecue, Freddy and Mehandjiev, Nikolay and Xu, Ling},
Book-Group-Author = {IEEE Comp Soc},
Title = {Using Context Similarity for Service Recommendation},
