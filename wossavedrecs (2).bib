Title = {Ontology Aggregation with Maximum Consensus Based on a Fuzzy
   Multi-criteria Group Decision-Making Method},
Booktitle = {ADVANCES IN FUZZY LOGIC AND TECHNOLOGY, EUSFLAT 2025, PT II},
Series = {Lecture Notes in Computer Science},
