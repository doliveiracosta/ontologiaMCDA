@article{ WOS:001530707800001,
Author = {Gao, Yuan and Zhang, Zhen and Yu, Wenyu},
Title = {Preference learning for multi-criteria sorting with interacting
   criteria: A framework integrating threshold-based value-driven sorting
   procedure with attention network},
Journal = {INFORMATION FUSION},
Year = {2026},
Volume = {125},
Month = {JAN},
Abstract = {Preference learning has emerged as a prominent approach to address
   multi-criteria sorting (MCS) problems, aiming to reduce the cognitive
   burden on decision makers. However, many existing preference learning
   methods for MCS rely on mathematical programming and assume preference
   independence among criteria, limiting their applicability in complex
   decision problems involving large-scale datasets and interdimensional
   correlations. This paper proposes a novel preference learning model that
   integrates an attention network into the threshold-based value-driven
   sorting procedure. The fundamental preference model comprises two key
   components: the value function and criteria interaction terms. To
   provide an explicit representation of preference information, the model
   employs neural network-based monotonic blocks to approximate marginal
   value functions. To capture interaction effects, an attention network is
   utilized to predict the importance degrees of pairwise interaction
   terms. Numerical experiments conducted on real-world datasets confirm
   the performance of the proposed preference learning model. Notably, the
   proposed model defines the underlying preference model based on
   monotonic value functions and designs the neural network architectures
   accordingly to reflect its explainable structure. By integrating
   multi-criteria decision aiding with neural network models, the proposed
   approach guarantees a high degree of interpretability and enhances
   predictive performance, ultimately providing robust support for MCS
   problems.},
