@article{ WOS:001791547000001,
Author = {Yang, Shanshan and Liao, Huchang},
Title = {Hotel selection based on online reviews by multi-criteria
   decision-making methods with word embedding keyword extraction and deep
   learning-based sentiment analysis},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2026},
Volume = {328},
Month = {OCT 1},
Abstract = {With the massive increase of online reviews, there is a need for methods
   to mine valuable information from online reviews to help consumers
   select hotels. Existing studies have combined sentiment analysis with
   multiple criteria decision-making methods for online hotel selection.
   However, there were limitations in keyword extraction, sentiment
   analysis, and criteria weight determination, which are key steps for
   online hotel selection. This paper introduces a multiple criteria
   decision-making method with word embedding keyword extraction and deep
   learning-based sentiment analysis to overcome the limitations of
   existing online hotel selection methods. A keyword extraction framework
   based on word embedding model is proposed using Twitter datasets and
   crawled online reviews. A multi-head attention-based Bi-directional LSTM
   method is introduced for sentiment analysis due to its ability to
   capture multi-level semantic relationships. A weight determination
   method integrating the number of different modifiers and the best-worst
   method is proposed to determine the weights of criteria. At last, the
   gained and lost dominance score method is employed to rank hotels. 5189
   online reviews of 11 hotels in Chengdu, China, posted from August 1,
   2005 to September 30, 2022 on TripAdvisor.com were analyzed to
   demonstrate the applicability of the proposed method. The results show
   that integrating keyword extraction and sentiment analysis with a
   multiple criteria decision-making model yields a robust hotel ranking
   for customer decision support and informs targeted hotel quality
   improvements by identifying criterion-level strengths and weaknesses.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
