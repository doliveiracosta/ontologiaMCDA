@article{ WOS:001752659000001,
Author = {Ahmad, Imran},
Title = {Integration as a Disciplinary Standard: Functional Ingredients, Circular
   Valorization, Process Design, and Sensory Science in Contemporary Food
   Research},
Journal = {JOURNAL OF CULINARY SCIENCE \& TECHNOLOGY},
Year = {2026},
Month = {2026 APR 30},
Abstract = {The manuscripts in this issue demonstrate that culinary and food science
   is advancing from single-variable improvement toward a multi-objective
   framework pursuing nutritional value, environmental responsibility,
   process efficiency, and sensory quality concurrently. This editorial
   identifies four connected themes. First, functional ingredients signal a
   move beyond fortification toward deliberate system design, with
   attention to plant proteins, fermented matrices, and underutilized
   cereal crops. Second, ingredient valorization reflects a commitment to
   circularity, with agri-food by-products increasingly reformulated as
   functional raw materials, embedding sustainability within the product
   itself. Third, process intelligence repositions processing conditions as
   primary design variables governing bioactive retention, texture, and
   flavor; response surface methodology enables structured multi-criteria
   optimization. Fourth, sensory science remains the gatekeeper of
   translational success, with digital and physiological tools expanding
   the capacity to predict consumer acceptance. Collectively, these studies
   signal a field evolving from descriptive experimentation toward
   intentional, integrated product development.},
