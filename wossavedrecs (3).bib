@inproceedings{ WOS:000232717800017,
Author = {Zhang, JM and Wei, XP and Wang, J},
Editor = {Batra, RC and Qian, LF and Zhang, YL and Li, XN and Tso, SK},
Title = {A knowledge-based heuristic approach to product conceptual design},
Booktitle = {Proceedings of the International Conference on Mechanical Engineering
   and Mechanics 2005, Vols 1 and 2},
Year = {2005},
Pages = {112-117},
Note = {International Conference on Mechanical Engineering and Mechanics,
   Nanjing Univ Sci \& Technol, Nanjing, PEOPLES R CHINA, OCT 26-28, 2005},
Abstract = {A knowledge-based heuristic approach for automating the conceptual
   design of mechanical products is presented. Firstly, a conceptual
   modelling framework is developed to represent product information in
   terms of function, behavior and structure. The function and behavior are
   modelled with transformation between input and output and bond graphs
   respectively. Then a framework for knowledge acquisition in conceptual
   design is established, which includes two parts: knowledge elicitation
   and knowledge representation. To represent the design knowledge
   formally, a knowledge template is constructed and the modules are
   encapsulated with object-oriented technique. Furthermore, by defining
   the heuristic evaluation function as a fuzzy multi-criteria
   decision-making, a A{*} algorithm-based heuristic solving strategy is
   developed to obtain the satisfied solution in a reasonable time.
   Finally, a design case of auto gate's driving system is given to
   demonstrate the proposed approach.},
