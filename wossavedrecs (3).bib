@article{ WOS:001780826200001,
Author = {Harrison, Ambe},
Title = {Physics-informed hybrid fuzzy-metaheuristic optimization for trustworthy
   photovoltaic module characterization: Enhancing identifiability,
   stability, and physical consistency},
Journal = {ENERGY REPORTS},
Year = {2026},
Volume = {15},
Month = {JUN},
Abstract = {Photovoltaic (PV) module characterization is a critical prerequisite for
   accurate performance prediction, condition monitoring, control design,
   and digital-twin deployment. However, to the best of the author's
   knowledge, most parameter-extraction studies remain centered on
   single-metric numerical fitting, typically root mean square error
   (RMSE), which can produce attractive curve-fitting results while
   overlooking physical credibility and parameter identifiability. This
   research proposes a trustworthy PV module characterization framework
   that goes beyond error minimization by explicitly embedding photovoltaic
   physics into the extraction process. A physicsinformed multicriteria
   objective is developed by coupling global I-V fitting accuracy with
   enforceable behavioral constraints, including consistency at
   short-circuit and open-circuit conditions, realistic boundary slopes,
   monotonic I-V response, unimodal power-voltage characteristics,
   non-negative operating voltage, plausible fill factor, and
   structure-free residual behavior. To solve the resulting nonconvex
   optimization problem, a hybrid fuzzy particle swarm
   optimization-artificial protozoa optimizer is introduced, in which fuzzy
   adaptation dynamically balances global exploration and local
   exploitation. The framework is evaluated on commercial PV modules using
   double-diode and triple-diode representations and benchmarked against
   established metaheuristic optimizers. The results show that
   incorporating physics does not compromise fitting performance; rather,
   it improves robustness, plausibility, and interpretability of the
   extracted parameters while maintaining strong numerical accuracy. By
   repositioning optimization as a tool for physics-respecting
   identification, the proposed framework provides a reliable pathway
   toward trustworthy PV characterization for monitoring, diagnostics, and
   advanced energy-system applications. The source code related to the
   newly introduced optimization framework is available from the link:
   https://doi.org/10.6084/m9.figshare.31868824},
