Title = {Construction of an Outranking Relation Based on Semantic Criteria with
   ELECTRE-III},
Booktitle = {INFORMATION PROCESSING AND MANAGEMENT OF UNCERTAINTY IN KNOWLEDGE-BASED
   SYSTEMS, IPMU 2016, PT II},
