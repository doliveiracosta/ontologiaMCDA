@article{ WOS:001684661000002,
Author = {Chyrmang, Genevieve and Barua, Barun and Bora, Kangkana and Saikia,
   Manob Jyoti and Ahmed, Gazi N.},
Title = {Color space aware synchronous and asynchronous transformer fusions for
   classification of ER biomarker in breast cancer IHC images},
Journal = {BIOMEDICAL SIGNAL PROCESSING AND CONTROL},
Year = {2026},
Volume = {118},
Month = {JUN 1},
Abstract = {Estrogen Receptor (ER) biomarker assessment in breast cancer via
   Immunohistochemistry (IHC) is critical factor for guiding treatment
   decisions. While deep learning has shown promise in automating this
   task, domain shifts caused by color variability across samples continue
   to limits model generalizability. The influence of diverse color space
   representations in conjunction with vision transformers remains
   underexplored in this context. In this study, we proposed a color
   space-aware transformer fusion framework for ER expression
   classification, investigating the joint contribution of color space
   transformations, transformer architectures and embedding fusion
   architectures. We benchmark five state-of-the-art transformer models:
   Swin Transformer V2, EdgeNeXt, TinyViT, MobileViT, and PVTv2, across six
   color spaces: RGB, LAB, HSL, HED, HSV, and YCbCr. Using MultiCriteria
   Decision Analysis (MCDA), we identify LAB and HSL as the most
   discriminative color spaces and Swin Transformer V2 and EdgeNeXt as the
   best-performing architectures. Based on these insights, we design two
   fusion architectures: Synchronous Fusion using homogeneous backbones and
   Asynchronous Fusion using heterogeneous backbones. Both architectures
   incorporate a Color Attention Fusion (CAF) module and a cosine
   similarity loss to enforce semantic alignment between color-modality
   embeddings. Extensive evaluation on test and out-of-distribution (OOD)
   sets shows that the Asynchronous Fusion model with cosine similarity
   achieves the highest performance (accuracy: 0.9104 test, 0.9176 OOD).
   Embedding cluster quality metrics (Silhouette Score, Davies-Bouldin
   Index, Calinski-Harabasz Index) and visualization tools (Grad-CAM, UMAP)
   further validate the enhanced feature compactness and domain robustness.
   This work demonstrates the synergistic potential of multi-color space
   fusion with transformers for robust and interpretable ER biomarker
   classification.},
