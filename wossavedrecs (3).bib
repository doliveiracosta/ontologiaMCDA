@article{ WOS:001758238100001,
Author = {Jin, Feifei and Li, Zhongwen and Zhou, Ligang},
Title = {Managing group decision-making with bounded rationality: a robust
   behavioral framework for consensus building and psychological preference
   analysis},
Journal = {COMPUTERS \& INDUSTRIAL ENGINEERING},
Year = {2026},
Volume = {217},
Month = {JUL},
Abstract = {Group decision-making (GDM) and the process of reaching consensus are
   critical in managerial contexts, yet existing models often lack dynamic
   and robust mechanisms while neglecting the psychological drivers of
   decision-makers (DMs). To address these gaps, this paper proposes a
   novel bounded rationality GDM method that integrates a robust
   minimum-adjustment consensus model (RMACM) with a stochastic
   multi-criteria disappointment-elation acceptability analysis (SMDEAA).
   First, we transform the raw data into linguistic distribution matrices
   and derive comprehensive evaluation score matrices, which is followed by
   the construction of a confidence-level-based dynamic consensus
   measurement model to assess consensus degrees. Subsequently, for
   feedback adjustment, we establish a minimum adjustment consensus model,
   which is further extended to an RMACM to analyze the stability of
   consensus under opinion uncertainty. Furthermore, by embedding
   disappointment theory into the SMAA-2 method, we develop the SMDEAA
   method for alternative selection, which explicitly captures DMs'
   psychological factors such as disappointment aversion. Finally, the
   usefulness and applicability of the designed method are confirmed
   through ranking hospitals' internal medicine departments in East China.
   The robustness and superiority of the developed method are further
   validated through comparative analysis and sensitivity analysis.},
