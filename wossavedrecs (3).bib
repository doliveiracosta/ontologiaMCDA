@inproceedings{ WOS:000361186200056,
Author = {Pop, Cristina Bianca and Chifu, Viorica R. and Salomie, Ioan and
   Dinsoreanu, Mihaela and Vartic, Iulia and Vlad, Monica},
Editor = {Watt, S and Negru, V and Ida, T and Jebelean, T and Petcu, D and Zaharie, D},
Title = {Immune-inspired Web Service Composition Framework},
Booktitle = {11TH INTERNATIONAL SYMPOSIUM ON SYMBOLIC AND NUMERIC ALGORITHMS FOR
   SCIENTIFIC COMPUTING (SYNASC 2009)},
Series = {International Symposium on Symbolic and Numeric Algorithms for
   Scientific Computing},
Year = {2009},
Pages = {376-383},
Note = {11th International Symposium on Symbolic and Numeric Algorithms for
   Scientific Computing (SYNASC), Timisoara, ROMANIA, SEP 26-29, 2009},
Organization = {IEEE; IEEE Comp Soc; W Univ Timisoara, Dept Comp Sci; Johannes Kepler
   Univ, Res Inst Symbol Computat; Inst e Austria},
Abstract = {This paper presents a new Web service composition method which combines
   the AI planning graph technique with an immune-inspired algorithm to
   find the optimal composition solution. Simultaneously with the planning
   graph construction, a matrix of semantic links is built to store the
   semantic links established between the services on different layers of
   the graph. The planning graph and the matrix of semantic links represent
   the main building blocks of our immune-inspired technique for finding
   the optimal composition solution. We use a multi-criteria function which
   evaluates the composition solution in terms of its QoS attributes and
   the quality of the semantic match between the services involved in the
   solution. In order to validate our approach to automatically compose Web
   services, we have developed an experimental framework that integrates
   the planning graph composition approach and the immune-inspired
   selection technique. We have performed our experiments on a set of Web
   services from two domains.},
Publisher = {IEEE COMPUTER SOC},
Address = {10662 LOS VAQUEROS CIRCLE, PO BOX 3014, LOS ALAMITOS, CA 90720-1264 USA},
