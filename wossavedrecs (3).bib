@inproceedings{ WOS:000286978600129,
Author = {Ozkan, Aysun and Banar, Mufide},
Editor = {Klemes, JJ and Lam, HL and Varbanov, PS},
Title = {Refuse Derived Fuel (RDF) Utilization in Cement Industry by Using
   Analytic Network Process (ANP)},
Booktitle = {PRES 2010: 13TH INTERNATIONAL CONFERENCE ON PROCESS INTEGRATION,
   MODELLING AND OPTIMISATION FOR ENERGY SAVING AND POLLUTION REDUCTION},
Series = {Chemical Engineering Transactions},
Year = {2010},
Volume = {21},
