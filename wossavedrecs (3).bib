@article{ WOS:001753723800001,
Author = {Jannat, Farhana Akter and Rony, Md. Rakib Hasan},
Title = {From data to disposal: The role of GIS in modern solid waste management},
Journal = {JOURNAL OF THE AIR \& WASTE MANAGEMENT ASSOCIATION},
Year = {2026},
Month = {2026 APR 30},
Abstract = {The escalating global solid waste crisis, with projections indicating
   that waste generation will reach 3.40 billion tons by 2050, necessitates
   innovative technological solutions to transform traditional waste
   management approaches. Geographic Information Systems (GIS) have
   demonstrated exceptional potential as comprehensive decision-support
   tools for sustainable solid waste management across diverse urban and
   rural contexts. This systematic review synthesizes current knowledge on
   GIS applications throughout the waste management continuum, examining
   implementation strategies, technological innovations, and performance
   outcomes across multiple geographical regions. The research methodology
   encompasses an analysis of peer-reviewed literature focusing on
   integrating GIS in waste generation assessment, collection system
   optimization, transfer facility planning, disposal site selection, and
   environmental impact monitoring. Results indicate that GIS-based
   interventions consistently deliver superior performance to conventional
   management approaches, with documented improvements including a 27.78\%
   reduction in collection distances, up to 42\% savings in operational
   costs, and enhanced accuracy in environmental risk assessment. The
   technology demonstrates particular efficacy when combined with
   multi-criteria decision analysis frameworks, enabling a comprehensive
   evaluation of complex spatial relationships and stakeholder
   requirements. Advanced applications incorporating machine learning
   algorithms and remote sensing data have further expanded GIS
   capabilities, supporting predictive modeling, real-time monitoring, and
   adaptive management strategies. Integration challenges identified
   include data standardization requirements, limitations in technical
   capacity, and the need for institutional coordination. The findings
   underscore the critical role of GIS technology in advancing sustainable
   waste management practices, particularly in developing countries where
   resource optimization is essential for system viability and
   environmental protection.Implications: GIS technology offers
   transformative potential for sustainable solid waste management, with
   documented cost reductions of 8-76.8\% and collection distance
   reductions of up to 27.78\%. Policymakers, especially in developing
   countries, should prioritize GIS integration through capacity building,
   data standardization, and institutional coordination. Its proven support
   for circular economy principles, climate change mitigation, and
   formal-informal sector collaboration provides strong justification for
   embedding geospatial technologies in environmental regulations and urban
   planning, ultimately advancing sustainable development goals around
   waste management and urban sustainability.},
