@article{ WOS:001784771900002,
Author = {Liu, Zhe and Han, Yuxu and Li, Yuhan and Singh, Narinderjit Singh
   Sawaran and Mbasso, Wulfran Fendzi and Hosseinzadeh, Mehdi},
Title = {A divergence-based compromise ranking framework under interval-valued
   Fermatean fuzzy environment with integrated weighting for green building
   material selection},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2026},
Volume = {329},
Month = {NOV 1},
Abstract = {The selection of green building material is a complex multi-criteria
   decision-making (MCDM) problem characterized by uncertainty and
   vagueness. Although interval-valued Fermatean fuzzy sets (IVFFSs)
   provide a flexible tool for representing such complex information,
   existing studies still face several limitations, including insufficient
   discrimination ability of existing distance/divergence measures, the
   zero-divisor problem, and the lack of an effective compromise-ranking
   mechanism. To address these issues, this study proposes a new
   divergence-based compromise ranking framework under interval-valued
   Fermatean fuzzy environment for green building material selection.
   First, a normalized divergence measure based on the Kullback-Leibler
   divergence is developed to effectively quantify the discrepancy between
   IVFFSs while overcoming the zero-divisor problem and enhancing
   discrimination capability. Based on the proposed divergence, a new
   entropy measure is further constructed to derive objective criterion
   weights. To incorporate both subjective judgments and objective
   information, an integrated weighting mechanism is established by
   combining the pivot pairwise relative criteria importance assessment
   (PIPRECIA) method with the proposed entropy measure. Subsequently, the
   compromise ranking of alternatives from distance to ideal solution
   (CRADIS) method is extended to the interval-valued Fermatean fuzzy
   environment by embedding the proposed divergence measure into the
   ranking procedure. The practicality and effectiveness of the proposed
   framework are demonstrated through a case study on sustainable indoor
   flooring material selection. The results identify rubber flooring tiles
   as the most sustainable option. Comparative analysis with several
   existing MCDM models reveals a high level of ranking consistency while
   confirming the stronger discrimination capability of the proposed
   framework. Sensitivity analysis further demonstrates that the ranking
   results remain stable under different weighting scenarios. Therefore,
   the proposed framework provides a robust and reliable decision-making
   tool for sustainable material selection under complex, uncertain
   environments.},
