@article{ WOS:001751467500001,
Author = {Sampathkumar, Swethaa and Augustin, Felix and Subramani, Karthik},
Title = {AI based intuitionistic dense fuzzy entropy decision-making system and
   its application in firefighting robot selection},
Journal = {AIN SHAMS ENGINEERING JOURNAL},
Year = {2026},
Volume = {17},
Number = {6},
Month = {JUN},
Abstract = {This study explores fuzzy entropy in the context of Intuitionistic Dense
   Fuzzy Sets (IDFS), considering the con vergence of a sequence xn is an
   element of DFS(X) to x is an element of DFS(X) as n -> infinity. Three
   novel formulations of Intuitionistic Dense Fuzzy Entropy (IDFE) are
   established using max-min operations, exponential and logarithmic
   functions. Based on performance evaluation, the most effective IDFE
   formulation is selected to handle Multi-Criteria Decision Making (MCDM)
   problems. To enhance decision-making efficiency, an integrated AI based
   approach is proposed by developing a Multi-Objective Intuitionistic
   Dense Fuzzy Breadth-First Search (MO-IDF-BFS) algorithm. This algorithm
   extends the traditional BFS framework by incorporating multi-objective
   optimization principles and embedding it within the IDFE and weighted
   sum product (WISP)-based decision structure. The applicability of the
   proposed framework is established for a firefighting robot selection
   problem. The proposed MO-IDF-BFS algo rithm determines an operational
   path that optimally balances travel distance and risk exposure, while
   the ranking of alternative robots is carried out using the integrated
   IDFE-WISP model. A comparative evaluation with the existing fuzzy MCDM
   models such as ARAS, WASPAS, COPRAS, WAS and WAP is carried out to
   validate the superior performance of the proposed system. Additionally,
   a machine learning-based validation using random forest regression and
   Leave-One-Out Cross-Validation confirms the reliability and internal
   consistency of the pro posed rankings with a Spearman correlation
   coefficient of p = 0.94 between predicted and actual ranks. Further,
   sensitivity analysis and Monte-Carlo experiment analysis confirm the
   robustness, stability and interpretability of the proposed model. The
   results indicate that the Thermite RS3 robot is the most suitable choice
   for intelligent firefighting systems.},
