@article{ WOS:001608343500002,
Author = {Chen, Yang and Cai, Shiwen and Zhang, Danning and Wang, Lu and Sun,
   Yuanjun},
Title = {An interpretable machine learning-assisted urban resilience evaluation
   and determinants identification: A case study of the Yangtze River
   Economic Belt, China},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2025},
Volume = {134},
Month = {NOV 15},
Abstract = {Urban resilience has emerged as a critical paradigm for sustainable
   development amid escalating climatic, social, and economic
   uncertainties. Rapid urbanization, resource depletion, and frequent
   compound disasters underline the need for more adaptive, data-driven
   resilience assessment frameworks. However, existing evaluation models
   often fail to capture the interactions and nonlinear chrematistics that
   characterize complex urban systems. Addressing this gap, this study
   develops an interpretable machine learning framework that integrates
   multi-criteria decision-making (MCDM) with the SHapley Additive
   exPlanations (SHAP) approach to evaluate the urban resilience index
   (URI) and identify its key determinants in China's Yangtze River
   Economic Belt (YREB)-a region encompassing 108 cities from 2011 to 2019.
   Results reveal an overall 18.49 \% growth in YREB's URI increase, albeit
   with strong spatial heterogeneity-downstream cities consistently
   outperform midstream and upstream regions. XGBoost-SHAP analysis
   identified governance (24.69 \% contribution) and infrastructure (23.19
   \%) as dominant determinants, with fiscal debt ratio (X23) and foreign
   investment (X25) being pivotal. Furthermore, four resilience archetypes
   emerged through a clustering algorithm, highlighting divergent policy
   priorities-advanced systems require innovation-driven governance, while
   fragile systems necessitate infrastructure-social security synergies.
   This study advances urban resilience theory through methodological
   integration of explainable AI and dynamic assessment, offering scalable
   solutions for global cities navigating compound pressures.},
