@article{ WOS:001332518600001,
Author = {Shunmugesh, K. and Paul, Brijesh and Sarker, Baneswar and Chakraborty,
   Shankar},
Title = {Parametric study and multi-objective optimization of milling of CFRP
   composite laminates},
Journal = {INTERNATIONAL JOURNAL OF INTERACTIVE DESIGN AND MANUFACTURING - IJIDEM},
Year = {2025},
Volume = {19},
Number = {7},
Pages = {5239-5254},
Month = {JUL},
Abstract = {Carbon fiber-reinforced polymer (CFRP) composites, possessing some
   unique properties, like high specific strength, stiffness, corrosion and
   temperature resistance etc. have now become attractive choices in many
   of the aviation, automobile, marine, military, medical, construction and
   sports industries. But, their anisotropic and non-homogeneous structure,
   and low thermal conductivity make them quite difficult to machine,
   occasionally leading to excessive tool wear and poor surface quality. In
   this paper, treating spindle speed (N), feed rate (f) and depth of cut
   (ap) as the input parameters, 27 milling experiments are conducted on
   CFRP composite laminates based on Taguchi's L27 orthogonal array, and
   their effects on material removal rate (MRR), and two surface roughness
   parameters, i.e. Ra and Rz are investigated. Results of the parametric
   analysis are later validated using an explainable artificial
   intelligence technique, in the form of Shapley Additive exPlanations
   (SHAP), accompanied by ascertaining the most significant input
   parameters affecting each of the responses of the milling process. The
   said process is finally optimized using a multi-criteria decision making
   tool, i.e. technique for order of preference by similarity to ideal
   solution (TOPSIS), identifying an ideal combination of the milling
   parameters as N = 7500 rpm, f = 0.3 mm/sec and ap = 1.5 mm, resulting in
   simultaneous maximization of MRR and minimization of the two surface
   roughness parameters. This paper thus provides a new framework for
   parametric analysis and multi-objective optimization of milling of CFRP
   composite laminates resulting in higher productivity along with better
   surface quality.},
