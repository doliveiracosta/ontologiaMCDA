@article{ WOS:001764794800001,
Author = {Behera, Madhumita and Panda, Amaresh Chandra},
Title = {A q-rung orthopair fuzzy Gaussian aggregation-based
   decision-making framework for sustainable solid waste management},
Journal = {APPLIED SOFT COMPUTING},
Year = {2026},
Volume = {199},
Month = {AUG},
Abstract = {The evaluation of solid waste management (SWM) alternatives is a complex
   decision-making problem involving multiple conflicting criteria and
   significant uncertainty due to hesitant and imprecise expert judgments.
   Existing fuzzy decision-making approaches often fail to adequately
   capture nonlinear information interactions and hesita tion effects. To
   address these limitations, this study proposes a novel multi-attribute
   decision-making framework based on a q-rung orthopair fuzzy Gaussian
   aggregation approach. The key novelty of the proposed method lies in
   embedding Gaussian information modeling into the q-rung orthopair fuzzy
   environment, enabling smooth, non linear, and adaptive aggregation of
   expert opinions. Two new aggregation operators, namely the q-rung
   orthopair fuzzy Gaussian weighted average (q-ROFGWA) and weighted
   geometric (q-ROFGWG) operators, are developed and their essential
   mathematical properties are rigorously established. Additionally, a new
   q-rung orthopair fuzzy score function is introduced to effectively
   incorporate hesitation and nonlinearity, providing enhanced discrim
   ination among alternatives. A numerical case study involving ten SWM
   alternatives demonstrates the practical applicability of the proposed
   framework, where alternative R1 achieves the highest score (0.8104),
   indicating the best overall performance, while R10 obtains the lowest
   score (0.6830). Comparative, sensitivity, and statistical analyses
   further confirm that the proposed framework offers superior ranking
   stability, robustness, and deci sion accuracy compared with existing
   methods. Overall, the proposed q-rung orthopair fuzzy Gaussian approach
   provides an effective and reliable decision-support tool for sustainable
   SWM evaluation under uncertainty.},
