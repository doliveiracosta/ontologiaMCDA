@article{ WOS:000736977400016,
Author = {Della Corte, Dennis and Colsman, Wolfgang and Fessenmayr, Heiko and da
   Silva, Alexandre Sawczuk and Vanderwall, Dana E.},
Title = {Self-reporting data assets and their representation in the
   pharmaceutical industry},
Journal = {DRUG DISCOVERY TODAY},
Year = {2022},
Volume = {27},
Number = {1},
Pages = {207-214},
Month = {JAN},
Abstract = {Standardizing data is crucial for preserving and exchanging scientific
   information. In particular, recording the context in which data were
   created ensures that information remains findable, accessible,
   interoperable, and reusable. Here, we introduce the concept of
   self-reporting data assets (SRDAs), which preserve data and contextual
   information. SRDAs are an abstract concept, which requires a suitable
   data format for implementation. Four promising data formats or languages
   are popularly used to represent data in pharma: JCAMP-DX, JSON, AnIML,
   and, more recently, the Allotrope Data Format (ADF). Here, we evaluate
   these four options in common use cases within the pharmaceutical
   industry using multiple criteria. The evaluation shows that ADF is the
   most suitable format for the implementation of SRDAs.},
