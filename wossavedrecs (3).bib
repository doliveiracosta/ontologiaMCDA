@article{ WOS:001784750500002,
Author = {Sharma, Chandan Kumar and Alam, Md. Shadab and Shankar, Ravi and Kumar,
   Ishant and Kumar, Ravi Ranjan and Kumar, Anant},
Title = {Probabilistic Liquefaction Safety Assessment Using Hybrid XGBoost Models
   with Explainable AI and Reliability Methods},
Journal = {TRANSPORTATION INFRASTRUCTURE GEOTECHNOLOGY},
Year = {2026},
Volume = {13},
Number = {5},
Month = {JUN 4},
Abstract = {This study proposed a hybrid machine learning framework integrated with
   reliability analysis to predict the factor of safety against
   liquefaction and quantify the associated uncertainties. Three optimized
   Extreme Gradient Boosting models, XGB-AOA, XGB-ESMA, and XGB-MPA, were
   developed and evaluated using comprehensive statistical, graphical, and
   probabilistic analyses. Model performance was assessed through actual
   and predicted comparisons, multi-criteria score evaluation, Regression
   Error Characteristic curves, Anderson-Darling testing, internal k-fold
   cross-validation, and external validation. Reliability-based methods,
   including the first-order reliability method, second-order reliability
   method, and higher-order approximations, were applied to estimate the
   probability of failure and reliability index. Model interpretability was
   investigated using SHapley Additive explanations (SHAP) to identify the
   most influential variables governing liquefaction resistance. Results
   indicated that the XGB-ESMA model achieved superior prediction accuracy,
   robustness, and generalisation capability compared with XGB-MPA and
   XGB-AOA. Reliability analysis revealed a high probability of failure
   (approximately 60-64\%) and negative reliability indices, suggesting
   unsafe conditions despite marginal deterministic safety factors. The
   SHAP analysis highlighted vertical stress and corrected standard
   penetration test blow count as the most influential parameters
   controlling liquefaction resistance. Overall, the proposed framework
   effectively integrates machine learning, reliability assessment, and
   explainable artificial intelligence to provide accurate, interpretable,
   and risk-informed liquefaction predictions for geotechnical engineering
   applications.},
