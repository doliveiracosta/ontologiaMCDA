@inproceedings{ WOS:000720289004068,
Author = {Kizielewicz, Bartlomiej and Baczkiewicz, Aleksandra},
Editor = {Watrobski, J and Salabun, W and Toro, C and Zanni-Merk, C and Howlett, RJ and Jain, LC},
Title = {Comparison of Fuzzy TOPSIS, Fuzzy VIKOR, Fuzzy WASPAS and Fuzzy MMOORA
   methods in the housing selection problem},
Booktitle = {KNOWLEDGE-BASED AND INTELLIGENT INFORMATION \& ENGINEERING SYSTEMS (KSE
   2021)},
Series = {Procedia Computer Science},
Year = {2021},
Volume = {192},
