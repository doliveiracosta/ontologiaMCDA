@article{ WOS:001794403800001,
Author = {Chen, Yang and Cai, Shiwen and He, Jinyi and Wen, Xiao},
Title = {A hybrid MCDM integrating XGBoost and explainable AI to assess urban
   ecosystem resilience and identify contributors: A case of Chinese cities},
Journal = {SUSTAINABLE CITIES AND SOCIETY},
Year = {2026},
Volume = {147},
Month = {SEP 1},
Abstract = {Urban ecosystem resilience (ER) is a fundamental prerequisite for global
   sustainable development in the face of accelerating urbanization and
   climate instability. Conventional frameworks, however, predominantly
   rely on linear aggregation schemes and provide limited interpretability
   regarding the relative contributions of different indicators. Here we
   present a hybrid framework integrating multi-criteria decision-making
   (MCDM) with explainable artificial intelligence (AI) to evaluate
   resilience and examine feature attribution patterns. By applying this
   approach to 292 Chinese cities from 2010 to 2022, we constructed a
   composite resilience index encompassing resistance, recovery,
   adaptability, and transformability. We show that national resilience
   increased by 28.69\% over the study period, with adaptability emerging
   as the dominant dimension. The SHapley Additive exPlanations (SHAP)
   analysis is used to characterize feature attribution patterns within the
   model. Feature contributions vary across their value ranges, reflecting
   heterogeneity in model-attributed contributions under the joint
   distribution of features (e.g., the contribution of urban green space is
   higher within certain value intervals and relatively smaller outside
   these ranges). These findings provide a transparent, data-driven pathway
   for quantifying complex urban dynamics, offering actionable insights for
   policymakers to optimize resilience strategies under uncertainty.},
