@article{ WOS:001637047100001,
Author = {Andukuri, Ravindra and Malleswari, V. Naga},
Title = {CNN-GNN-based feature recognition and fuzzy MCDM strategy ranking from
   STEP files: a case study on intelligent machining decisions},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2026},
Volume = {303},
Month = {MAR 25},
Abstract = {This study presents an integrated framework combining deep
   learning-based automatic feature recognition (AFR) with a hybrid
   multi-criteria decision-making (MCDM) model for intelligent machining
   strategy selection directly from ISO 10303-21 STEP files. The AFR module
   leverages a CNN-GNN architecture to extract geometric and topological
   embeddings, classifying feature types such as holes, pockets, and slots
   with associated attributes. A hybrid decision model-comprising fuzzy
   Analytic Hierarchy Process (AHP), entropy weighting, and fuzzy VIKOR-is
   used to evaluate and rank machining alternatives based on criteria like
   tool accessibility, surface finish, machining time, and tolerance level.
   The framework is validated using a detailed case study on a blind hole
   feature from a prismatic CAD model. Fuzzy VIKOR ranking identified
   reaming as the optimal strategy with a Qiindex of 0.267, matching expert
   recommendations with 92.3\% consistency. The framework demonstrated
   stable rankings across different values of the VIKOR compromise
   parameter (v = 0.3, 0.5, 0.7), confirming robustness under parameter
   variation. Additional robustness checks with +/- 20 \% weight
   perturbations also confirmed stable rankings, as detailed in the
   supplementary material. This pilot-scale proof-of-concept framework
   demonstrates high accuracy, reduced decision time, and enhanced
   explainability, supporting Industry 4.0 process planning systems, while
   acknowledging the limitation of a small-scale dataset used for initial
   validation.},
