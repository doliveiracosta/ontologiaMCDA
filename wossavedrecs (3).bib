@inproceedings{ WOS:000861288500092,
Author = {Wieczynski, Jonata and Lucca, Giancarlo and Borges, Eduardo and
   Emmendorfer, Leonardo and Ferrero-Jaurrieta, Mikel and Dimuro, Gracaliz
   and Bustince, Humberto},
Book-Group-Author = {IEEE},
Title = {Applying d-XChoquet integrals in classification problems},
Booktitle = {2022 IEEE INTERNATIONAL CONFERENCE ON FUZZY SYSTEMS (FUZZ-IEEE)},
Series = {IEEE International Fuzzy Systems Conference Proceedings},
Year = {2022},
Note = {IEEE International Conference on Fuzzy Systems (FUZZ-IEEE) / IEEE World
   Congress on Computational Intelligence (IEEE WCCI) / International Joint
   Conference on Neural Networks (IJCNN) / IEEE Congress on Evolutionary
   Computation (IEEE CEC), Padua, ITALY, JUL 18-23, 2022},
Organization = {IEEE; Int Neural Network Soc; IEEE Computat Intelligence Soc;
   Evolutionary Programming Soc; IET; Univ Padova, Dept Math Tullio Levi
   Civita; European Space Agcy; expert.ai; Elsevier; Springer Nature;
   Google; Baker \& Hughes; NVIDIA},
Abstract = {Several generalizations of the Choquet integral have been applied in the
   Fuzzy Reasoning Method (FRM) of Fuzzy Rule -Based Classification Systems
   (FRBCS's) to improve its performance. Additionally, to achieve that
   goal, researchers have searched for new ways to provide more flexibility
   to those generalizations, by restricting the requirements of the
   functions being used in their constructions and relaxing the
   monotonicity of the integral. This is the case of CT-integrals, CC
   -integrals, CF-integrals, CF1F2-integrals and dCF-integrals, which
   obtained good performance in classification algorithms, more
   specifically, in the fuzzy association rule -based classification method
   for high -dimensional problems (FARC-HD). Thereafter, with the
   introduction of Choquet integrals based on restricted dissimilarity
   functions (RDFs) in place of the standard difference, a new
   generalization was made possible: the d-XChoquet (d-XC) integrals, which
   are ordered directional increasing functions and, depending on the
   adopted RDF, may also be a pre-aggregation function. Those integrals
   were applied in multi-criteria decision making problems and also in a
   motor-imagery brain computer interface framework. In the present paper,
   we introduce a new FRM based on the d-XC integral family, analyzing its
   performance by applying it to 33 different datasets from the literature.},
