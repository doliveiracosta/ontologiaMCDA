@article{ WOS:000837702900001,
Author = {Singh, Vinay and Konovalova, Iuliia and Kar, Arpan Kumar},
Title = {When to choose ranked area integrals versus integrated gradient for
   explainable artificial intelligence - a comparison of algorithms},
