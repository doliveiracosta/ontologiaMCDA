@inproceedings{ WOS:001455819500011,
Author = {Liu, Tingting and Li, Tianrui and Song, Baoyan and Du, Yuefeng and Yang,
   Hongxin and Ding, Linlin},
Editor = {Zhang, W and Tung, A and Zheng, Z and Yang, Z and Wang, X and Guo, H},
Title = {A Time-Aware Sequential Recommendation Based on Attention Mechanism},
Booktitle = {WEB AND BIG DATA. APWEB-WAIM 2024 INTERNATIONAL WORKSHOPS, KGMA 2024,
   SEMIBDMA 2024, MADM 2024, AIEDM 2024 AND STBDM 2024},
