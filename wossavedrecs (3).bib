@article{ WOS:001702559700001,
Author = {Sengupta, Atanu and Aishwaryaprajna},
Title = {Multi-dimensional interval ordering for achieving Pareto solutions with
   explainability},
Journal = {ENGINEERING OPTIMIZATION},
Year = {2026},
Month = {2026 FEB 11},
Abstract = {Interval parameters offer a straightforward and intuitive approach to
   integrating data uncertainty into intricate decision-making scenarios.
   When interval data are used as coefficients in multi-criteria
   optimization, each feasible solution generates multiple interval
   criterion values, resulting in multi-dimensional (multi-D)
   interval-boxes. However, selecting an appropriate ordering relation
   between these multi-D interval-boxes is a challenging task. This article
   commences by conceptualizing multi-D interval-boxes as the extension of
   conventional interval numbers on the real line. Subsequently, these
   boxes are evaluated and ranked by redefining the Pareto dominance
   relations within an interval-valued context. The proposed methodology
   incorporates the acceptability index and fuzzy preference ordering for
   ranking intervals and is extended into a unified, interpretable, and
   reproducible framework applicable to multi-D scenarios. A multi-criteria
   decision methodology is developed by outlining algorithms to rank
   interval-valued solutions. Suitable examples are presented to illustrate
   the application of the proposed dominance rule to these multi-D
   interval-boxes.},
