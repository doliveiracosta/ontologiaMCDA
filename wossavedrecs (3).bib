@article{ WOS:001623158700001,
Author = {Gouveia, Juliana Rocha and Costa, Adivane Terezinha and de Lima, Hernani
   Mota},
Title = {Prioritizing mine closure in Brazil's quadrilatero ferrífero: A maturity
   analysis tool for open-pit mines},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2025},
Volume = {534},
Month = {DEC 1},
Abstract = {Mine closure planning remains a critical challenge for the mining
   industry, requiring a balanced integration of technical, socio-economic,
   and regulatory considerations. This study introduces a dynamic
   multi-criteria maturity analysis tool to prioritise closure activities
   in open-pit mines, addressing gaps in existing static frameworks. The
   tool uses a prioritization matrix and 3D mining software (e.g.,
   Datamine, Maptek) to evaluate closure readiness across five key
   criteria: strategic alignment, physical stability, hydrological
   management, legal compliance, and socio-environmental impacts. When
   applied to five open pits in Brazil's Quadrilatero Ferr \& iacute;fero,
   the tool identified Pit A7 as critically urgent due to geotechnical
   vulnerabilities, outdated data, and a 2027 closure deadline, while Pit
   C21 required accelerated updates to align closure plans with operational
   timelines. The results underscore the importance of robust data
   management, phased action plans, and stakeholder consensus via the
   Delphi method for weighting criteria. The tool's modular design enables
   adaptability to diverse mining contexts, including underground mines and
   tailings facilities, and addresses regional challenges such as water
   scarcity or cultural preservation. Limitations include potential
   regional bias in criteria weighting and the absence of explicit economic
   metrics, suggesting future integration of cost-benefit analyses. By
   embedding closure planning within operational lifecycles, this approach
   reduces liabilities and promotes sustainable post-mining landscapes,
   offering a scalable blueprint for global mining sectors.},
