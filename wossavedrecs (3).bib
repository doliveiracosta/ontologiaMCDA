@article{ WOS:000731140600001,
Author = {Sevastjanov, Pavel and Dymova, Ludmila and Kaczmarek, Krzysztof},
Title = {The New Definitions of Intuitionistic and Belief-Plausibility Based
   Local Criteria With Interval and Fuzzy Inputs Applied to the Multiple
   Criteria Problem of a Raw Material Supplier Selection},
Journal = {IEEE ACCESS},
Year = {2021},
Volume = {9},
Pages = {163747-163763},
Abstract = {The problems of the A-IFS and A-IVIFS theories are analyzed and to solve
   them, their Dempster-Shafer theory based redefinition is developed and a
   new concept called Belief-Plausibility number (BPN) is introduced. The
   BPN can be applied beyond semantics of usual fuzzy sets and the A-IFS.
   Two main sources of uncertainty generating the A-IVIFS are considered:
   an uncertainty coursed by the membership and non-membership functions
   multiplicity and an uncertainty of inputs. For the fuzzy inputs, the
   definition of the fuzzy-valued BPN is proposed. The developed approach
   to treat interval-valued intuitionistic fuzzy objects and their
   Belief-Plausibility re-definitions allowed us to introduce a set of
   useful definitions. It is important that some of the them were not
   earlier mentioned in the literature. The corresponding new arithmetical
   operations with such objects are proposed. The practical usefulness of
   the introduced approach is illustrated by the solution of the real-world
   Fuzzy-Valued Belief-Plausibility multiple criteria problem of the raw
   material suppliers selection on the steel rolling plant. The obtained
   results allowed us to state that the introduced Belief-Plausibility
   approach can be successfully used in the analysis and applications
   independently, without the use of the A-IFS concepts. This approach owns
   visible advantages in comparison with the A-IFS based one.},
Publisher = {IEEE-INST ELECTRICAL ELECTRONICS ENGINEERS INC},
Address = {445 HOES LANE, PISCATAWAY, NJ 08855-4141 USA},
Type = {Article},
Language = {English},
Affiliation = {Sevastjanov, P (Corresponding Author), Czestochowa Tech Univ, Dept Comp Sci, PL-42201 Czestochowa, Poland.
   Sevastjanov, Pavel; Dymova, Ludmila; Kaczmarek, Krzysztof, Czestochowa Tech Univ, Dept Comp Sci, PL-42201 Czestochowa, Poland.},
