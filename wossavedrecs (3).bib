@inproceedings{ WOS:001460753300032,
Author = {Ulitin, Boris and Babkin, Eduard and Zykov, Sergey V.},
Editor = {Czarnowski, I and Howlett, RJ and Jain, LC},
Title = {Crisisology-Based Decision-Making Model in Updating Geographical
   Information Systems for Regions},
