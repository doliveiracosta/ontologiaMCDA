   Pop, Cristina Bianca; Chifu, Viorica R.; Salomie, Ioan; Dinsoreanu, Mihaela; Vartic, Iulia; Vlad, Monica, Tech Univ Cluj Napoca, Dept Comp Sci, Cluj Napoca, Romania.},
DOI = {10.1109/SYNASC.2009.47},
ISSN = {2470-8801},
ISBN = {978-0-7695-3964-5},
Keywords = {semantic Web service discovery; semantic Web service composition; QoS;
